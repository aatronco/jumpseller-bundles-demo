{% assign images_size = prod.images.size %}
{% assign gallery_type = component.options.gallery_type %}
{% assign gallery_columns = component.options.gallery_columns %}
{% assign has_zoom = component.options.gallery_zoom %}
{% assign zoom_size = component.options.gallery_zoom_size %}
{% assign pg_grid_images = images_size | plus: 0 | at_least: 1 %}
{% assign pg_grid_cols = gallery_columns | default: 2 | plus: 0 | at_most: pg_grid_images %}

<style>
  #component-{{ component.id }} {
    --theme-object-fit: {{ component.options.gallery_image_display }};
    --product-gallery-dimension: var(--aspect-ratio-{{ component.options.gallery_image_dimension }});
  }
</style>

{% capture zoom_icon %}
  {% if images_size > 0 and has_zoom %}
    <span class="product-gallery__zoom-icon trsn" data-bs-toggle="tooltip" data-bs-title="{% t 'Place your mouse over the image to zoom in and see it with more detail' %}">
      <i class="ph ph-magnifying-glass-plus d-md-block d-none"></i>
      <i class="ph ph-arrows-out-simple d-md-none"></i>
    </span>
  {% endif %}
{% endcapture %}

{% assign widths = '320,480,640,768,1024,1280,1600' | split: ',' %}

{% capture sizes %}
  (min-width: 784px) calc((50vw - calc(var(--section-content-static-padding) * .5) * ({{ pg_grid_cols }} - 1))) / {{ pg_grid_cols }}), calc((100vw - calc(var(--section-content-static-padding) * .5) * ({{ pg_grid_cols }} - 1))) / {{ pg_grid_cols }})
{% endcapture %}

{% capture product_gallery_main %}
  {% assign product_gallery_main_class = 'swiper-slide product-gallery__slide' %}

  {% if component.options.gallery_image_format %}
    {% if images_size == 0 %}
      <div class="{{ product_gallery_main_class }}">
        <div class="theme-image-placeholder theme-image-placeholder--{{ component.options.gallery_image_dimension }}"></div>
      </div>
    {% else %}
      {% for image in prod.images %}
        <div class="{{ product_gallery_main_class }}">
          <div class="product-gallery__picture{% if has_zoom %} swiper-zoom-container{% endif %}">
            {% if gallery_type == 'grid' %}
              {{ zoom_icon }}
            {% endif %}

            {% if has_zoom %}
              {% assign zoom_width = 960 | times: zoom_size | round: 0 %}
              <img
                src="{{ image.url | thumb: width: zoom_width }}"
                alt="{{ prod.name }} {{ forloop.index }}"
                class="product-gallery__image product-gallery__image--hidden"
                width="{{ 960 | times: zoom_size | round: 0 }}"
                height="{{ 960 | times: zoom_size | round: 0 }}"
                loading="eager"
                decoding="sync"
                fetchpriority="high"
              >
            {% endif %}
            <img
              src="{{ image.url | thumb: width: 960 }}"
              srcset="
                {% for w in widths %}
                  {{ image.url | thumb: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
                {% endfor %}
              "
              sizes="{{ sizes | strip }}"
              alt="{{ prod.name }} {{ forloop.index }}"
              class="product-gallery__image"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              decoding="async"
              {{ image.attributes.width_and_height }}
              fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
            >
          </div>
        </div>
      {% endfor %}
    {% endif %}
  {% elsif component.options.gallery_image_format == false %}
    {% if images_size == 0 %}
      <div class="{{ product_gallery_main_class }}">
        <div class="theme-image-placeholder theme-image-placeholder--square"></div>
      </div>
    {% else %}
      {% for image in prod.images %}
        <div class="{{ product_gallery_main_class }}">
          {% if gallery_type == 'grid' %}
            {{ zoom_icon }}
          {% endif %}

          <picture class="product-gallery__picture{% if has_zoom %} swiper-zoom-container{% endif %}">
            <img src="{{ image }}" alt="{{ prod.name }} {{ forloop.index }}" class="product-gallery__image product-gallery__image--main" width="auto" height="auto" loading="eager" decoding="sync" fetchpriority="high">
          </picture>
        </div>
      {% endfor %}
    {% endif %}
  {% endif %}
{% endcapture %}

{% capture product_gallery_arrows %}
  <button type="button" class="button swiper-button-prev product-gallery__arrow product-gallery__arrow--prev" aria-label="{% t 'Previous image' %}">
    <i class="ph ph-arrow-circle-left"></i>
  </button>

  <button type="button" class="button swiper-button-next product-gallery__arrow product-gallery__arrow--next" aria-label="{% t 'Next image' %}">
    <i class="ph ph-arrow-circle-right"></i>
  </button>
{% endcapture %}

{% case options.theme_corners_style %}
  {% when 'rectangular' %}
    {% assign data_corners = 'none' %}
  {% else %}
    {% if options.theme_spacing == 'none' %}
      {% assign data_corners = component.options.gallery_image_corners %}
    {% else %}
      {% assign data_corners = options.theme_corners_style %}
    {% endif %}
{% endcase %}

<div
  class="product-gallery__wrapper{% if gallery_type == 'carousel' and component.options.gallery_image_sticky %} sticky-md-top{% endif %}"
  data-type="{{ gallery_type }}"
  data-format="{{ component.options.gallery_image_format }}"
  data-thumbs="{% if gallery_type == 'grid' %}bottom{% else %}{{ component.options.gallery_thumbs_position }}{% endif %}"
  data-dimension="{{ component.options.gallery_image_dimension }}"
  data-corners="{{ data_corners }}"
  data-zoom="{{ has_zoom }}"
  style="--pg-zoom-scale: {{ zoom_size }}; --pg-grid-cols: {{ pg_grid_cols }}"
>
  {{ zoom_icon }}

  <swiper-slider
    class="swiper product-gallery__carousel product-gallery__carousel--main{% if gallery_type == 'grid' %} product-gallery__main--grid{% endif %}"
    data-type="{{ gallery_type }}"
    data-zoom="{{ has_zoom }}"
    sw-layout="product-gallery"
    sw-thumbs="{{ component.options.gallery_thumbs }}"
    sw-autoplay="false"
    sw-zoom="{{ has_zoom }}"
    sw-zoom-size="{{ zoom_size }}"
    sw-auto-height="{{ component.options.gallery_image_format }}"
  >
    <div class="swiper-wrapper">
      {{ product_gallery_main }}
    </div>

    {% unless component.options.gallery_thumbs %}
      {{ product_gallery_arrows }}
    {% endunless %}
  </swiper-slider>

  {% if component.options.gallery_thumbs and images_size > 1 %}
    {% render 'product_gallery_thumbs', prod: prod, product_gallery_arrows: product_gallery_arrows %}
  {% endif %}
</div>
