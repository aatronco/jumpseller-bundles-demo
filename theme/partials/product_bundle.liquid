{%- comment -%}
  Bundle/pack marker for the product page. Renders a <product-bundle> element carrying the pack's
  id/url/name plus its components RESOLVED SERVER-SIDE in Liquid (id, qty, variant_id, discounted
  unit price) via the bundle_data partial — no client-side fetching. assets/bundles.js consumes it.
{%- endcomment -%}
{%- assign bundle_raw = '' -%}
{%- for field in prod.product_fields -%}
  {%- if field.label == 'bundle_components' -%}
    {%- for cfv in field.custom_field_values -%}
      {%- assign bundle_raw = cfv.value -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{%- if bundle_raw != blank -%}
  <product-bundle class="product-bundle" data-pack-url="{{ prod.url }}">
    <script type="application/json" class="product-bundle-json">
      {"pack":{"id":{{ prod.id | json }},"url":{{ prod.url | json }},"name":{{ prod.name | json }}},"components":{% render 'bundle_data', bundle_raw: bundle_raw %}}
    </script>
  </product-bundle>
{%- endif -%}
