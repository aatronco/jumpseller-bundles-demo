{% capture image_thumbnails %}
  {% for image in prod.images %}
    <div class="swiper-slide product-gallery__thumb">
      <div class="product-gallery__thumb--container">
        <img
          src="{{ image.url | thumb: width: 84 }}"
          srcset="
            {{ image.url | thumb: width: 90 }} 90w,
            {{ image.url | thumb: width: 140 }} 140w,
            {{ image.url | thumb: width: 200 }} 200w
          "
          sizes="
            (min-width: 991px) 200px,
            (min-width: 480px) 140px,
            90px
          "
          alt="{{ prod.name }} - {% t 'thumbnail' %} {{ forloop.index }}"
          class="product-gallery__image product-gallery__image--thumb"
          {{ image.attributes.width_and_height }}
          loading="lazy"
          {% if template == 'cart' %}
            decoding="auto"
            fetchpriority="auto"
          {% else %}
            decoding="async"
            fetchpriority="low"
          {% endif %}
        >
      </div>
    </div>
  {% endfor %}
{% endcapture %}

<swiper-slider
  class="swiper product-gallery__carousel product-gallery__carousel--thumbs"
  sw-layout="product-gallery-thumbs"
  sw-thumbs-direction="{% if component.options.gallery_thumbs_position == 'bottom' %}horizontal{% else %}vertical{% endif %}"
  sw-autoplay="false"
>
  <div class="swiper-wrapper">
    {{ image_thumbnails }}
  </div>

  {{ product_gallery_arrows }}
</swiper-slider>
