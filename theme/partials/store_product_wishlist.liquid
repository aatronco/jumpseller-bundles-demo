{% capture product_form %}
  {% capture t_add_to_cart_default %}{% t "Add to Cart" %}{% endcapture %}
  {% assign t_add_to_cart = options.t_add_to_cart | default: t_add_to_cart_default %}
  {% capture t_contact_us_default %}{% t "Contact us" %}{% endcapture %}
  {% assign t_contact_us = options.t_contact_us | default: t_contact_us_default %}
  {% capture t_not_available_default %}{% t "Not available" %}{% endcapture %}
  {% assign t_not_available = options.t_not_available | default: t_not_available_default %}
  {% capture t_out_of_stock_default %}{% t "Out of Stock" %}{% endcapture %}
  {% assign t_out_of_stock = options.t_out_of_stock | default: t_out_of_stock_default %}

  {% unless options.disable_shopping_cart %}
    <form
      action="{{ product_info.add_to_cart_url }}"
      class="store-product__form trsn"
      method="post"
      enctype="multipart/form-data"
      name="buy"
    >
      {% assign option_types = product_info.options | map: 'type' -%}

      {% if options.display_cart_notification == false or option_types contains 'file' %}
        <button
          type="submit"
          class="button button--style button--main button--small store-product__add-to-cart"
        >
          {% if options.theme_icon_cart_button %}<i class="theme-icon ph {{ options.theme_icon_cart }}"></i>{% endif -%}
          <span>{{ t_add_to_cart }}</span>
        </button>
      {% else %}
        <button
          type="button"
          class="button button--style button--main button--small store-product__add-to-cart"
          data-product-id="{{ product_id }}"
          data-variant-id="{{ product_info.id }}"
          data-product-name="{{ product_info.name }}"
        >
          {% if options.theme_icon_cart_button %}<i class="theme-icon ph {{ options.theme_icon_cart }}"></i>{% endif -%}
          <span>{{ t_add_to_cart }}</span>
        </button>
      {% endif %}
    </form>
  {% endunless %}
{% endcapture %}

<div class="store-product__actions">
  {% if product_info.status == 'not-available' %}
    <div class="store-product__label store-product__label--wishlist" data-label="warning">
      {{- t_not_available -}}
    </div>
  {% elsif product_info.stock == 0 and product_info.stock_unlimited == false %}
    <a
      href="{{ product_info.back_in_stock_url }}"
      class="button button--style button--secondary button--small product-message__button"
      title="{%- t 'Notify me when available' -%}"
      target="_blank"
      data-label="warning"
    >
      {{- t_out_of_stock -}}
      <i class="theme-icon ph ph-bell"></i>
    </a>
  {% else %}
    {{ product_form }}
  {% endif %}

  {% if product_info.status == 'not-available' %}
    <a
      href="{{ contact.url }}"
      class="button button--style button--secondary button--small product-message__button"
      title="{{ t_contact_us }}"
      target="_blank"
    >
      <i class="theme-icon ph ph-envelope-simple"></i>
      {{ t_contact_us }}
    </a>
  {% endif %}

  <button
    type="button"
    class="button store-product__delete"
    onclick="removeFromWishlistCustomer(this,'{{ product_info.wishlist_remove_url }}')"
  >
    {%- t 'Remove' -%}
  </button>
</div>
