{% capture t_languages_default %}{% t "Languages" %}{% endcapture %}
{% assign t_languages = options.t_languages | default: t_languages_default %}
{% capture t_currency_default %}{% t "Currency" %}{% endcapture %}
{% assign t_currency = options.t_currency | default: t_currency_default %}

<div
  class="offcanvas offcanvas-start sidebar"
  tabindex="-1"
  id="mobile-menu"
  aria-labelledby="mobile-menu-label"
  data-version="{{ header_version }}"
  data-bundle-color="{{ component.options.bundle_color }}"
>
  <div class="offcanvas-header sidebar-header sidebar-header--transparent">
    {% render 'header_logo', logo_position: 'mobile' %}

    <button type="button" class="button sidebar-header__close" data-bs-dismiss="offcanvas" aria-label="{% t 'Close' %}"><i class="ph ph-x-circle"></i></button>
  </div>
  <!-- end .sidebar-header -->

  <div class="offcanvas-body sidebar-body">
    {% render 'sidebar_accordion', t_view_all: t_view_all %}

    {% if component.options.show_social %}
      {% render 'store_social', position: 'mobile-menu' %}
    {% endif %}

    {% if languages.size > 1 or store.currencies_codes.size > 1 %}
      <div class="sidebar-menu">
        <div class="d-flex align-items-start justify-content-between sidebar-menu__wrapper">
          {% if languages.size > 1 %}
            <div class="w-50 d-block">
              <div class="sidebar-menu__title">{{ t_languages }}</div>

              <div class="dropup">
                {% render 'dropdown_language', header_items_text: true, dropdown_position: 'sidebar' %}
              </div>
            </div>
          {% endif %}

          {% if store.currencies_codes.size > 1 %}
            <div class="w-50 d-block">
              <div class="sidebar-menu__title">{{ t_currency }}</div>

              <div class="dropup">
                {% render 'dropdown_currency', header_items_text: true, dropdown_position: 'sidebar' %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
  <!-- end .sidebar-body -->
</div>
