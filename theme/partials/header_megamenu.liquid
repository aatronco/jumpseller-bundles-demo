{% assign item_columns = item.items.size %}

<div class="header-megamenu dropdown-menu">
  <div class="container header-megamenu__container">
    <div class="row header-megamenu__row">
      {% for item in item.items %}
        {% render 'header_megamenu_item',
          item: item,
          item_columns: item_columns,
          submenu_columns: submenu_columns,
          submenu_columns_width: submenu_columns_width,
          submenu_image: submenu_image,
          submenu_image_ratio: submenu_image_ratio,
          submenu_image_position: submenu_image_position,
          submenu_image_width: submenu_image_width,
          submenu_view_all: submenu_view_all,
          t_view_all: t_view_all,
          t_go_to: t_go_to
        %}
      {% endfor %}

      {% if submenu_view_all %}
        {% unless item.type == 'no_url' %}
          {% capture last_item_text %}
            {%- t "Go to" %}
            {{ item.name -}}
          {%- endcapture %}
          <div class="col-12 text-center header-megamenu__column header-megamenu__column--last">
            <hr class="header-megamenu__divider">

            <a
              href="{{ item.url }}"
              class="header-megamenu__link header-megamenu__link--all"
              title="{{ last_item_text }}"
              {% if item.external %}
                target="_blank"
              {% endif %}
            >
              {{- last_item_text -}}
              <i class="ph ph-arrow-right"></i>
            </a>
          </div>
        {% endunless %}
      {% endif %}
    </div>
  </div>
</div>
