{% capture t_from_filter_default %}{% t "From" %}{% endcapture %}
{% assign t_from_filter = options.t_from_filter | default: t_from_filter_default %}
{% capture t_to_filter_default %}{% t "To" %}{% endcapture %}
{% assign t_to_filter = options.t_to_filter | default: t_to_filter_default %}
{% capture t_filter_by_price_default %}{% t "Filter by price" %}{% endcapture %}
{% assign t_filter_by_price = options.t_filter_by_price | default: t_filter_by_price_default %}

{% if options.filters_price and template == 'category' %}
  {% capture filters_price_reset %}
    <button
      type="button"
      class="button theme-filters__tag theme-filters__tag--remove theme-filters__tag--remove-price"
      onclick="removePriceFilters()"
    >
      {%- t "Reset" -%}
    </button>
  {% endcapture %}

  <div id="theme-filters-price" class="theme-filters__block" data-url="price">
    <div>
      {% if collapse %}
        <button
          type="button"
          class="button theme-filters__subtitle"
          data-bs-toggle="collapse"
          data-bs-target="#theme-filters-price-group"
          aria-expanded="{% if collapse_status == 'open' %}true{% else %}false{% endif %}"
          aria-controls="theme-filters-price-group"
        >
          {{ t_filter_by_price }}
          <i class="ph ph-caret-down theme-filters__caret"></i>
        </button>
      {% else %}
        <h6 class="theme-filters__subtitle">{{ t_filter_by_price }}</h6>

        {{ filters_price_reset }}
      {% endif %}
    </div>

    <div
      {% if collapse %}
        id="theme-filters-price-group"
      {% endif %}
      class="theme-filters__list{% if collapse %} collapse{% endif %}{% if collapse and collapse_status == 'open' %} show{% endif %}"
    >
      {% if collapse %}
        <div class="w-100 d-block">
          {{ filters_price_reset }}
        </div>
      {% endif %}

      <div class="theme-filters__price-group">
        <div class="w-50 d-block">
          <label class="theme-filters__label" for="min-price">
            <small>{{ t_from_filter }}</small>
          </label>
          <input id="min-price" placeholder="{{ category.products_min_price | price }}" class="text theme-filters__input" name="min" type="number" min="0">
        </div>

        <div class="w-50 d-block">
          <label class="theme-filters__label" for="max-price">
            <small>{{ t_to_filter }}</small>
          </label>
          <input id="max-price" placeholder="{{ category.products_max_price | price }}" class="text theme-filters__input" name="max" type="number" min="0" max="{{ category.products_max_price | price }}">
        </div>
      </div>

      {% if filters_behavior %}
        <div class="w-100 d-none d-md-block">
          <button class="button button--style button--secondary w-100 text-center" type="submit">
            <span>{%- t "Apply price filter" -%}</span>
          </button>
        </div>
      {% endif %}
    </div>

    <div class="theme-filters__list">
      <div class="theme-filters__message d-none">{%- t "The maximum price cannot be lower than the minimum price" %}.</div>
    </div>
  </div>
{% endif %}
