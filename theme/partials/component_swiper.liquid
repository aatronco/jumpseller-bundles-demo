<swiper-slider
  class="swiper theme-section__carousel"
  sw-layout="{{ sw_layout }}"
  sw-auto-height="{{ sw_autoheight }}"
  {{ sw_columns | strip }}
  sw-root=".theme-section__content"
  sw-autoplay="{{ component.options.autoplay }}"
  sw-speed="{{ component.options.autoplay_speed }}"
  {% if component.options.autoplay_continuous %}
    sw-continuous="{{ component.options.autoplay_continuous }}"
    sw-speed-mobile="{{ component.options.autoplay_speed_mobile }}"
  {% endif %}
>
  {% if sw_layout == 'instagram' and social.instagram.url != blank %}
    {{ sw_content }}
  {% elsif sw_layout == 'product-reviews' %}
    {{ sw_content }}
  {% else %}
    <div class="swiper-wrapper">
      {{ sw_content }}
    </div>
  {% endif %}
</swiper-slider>

{% unless component.options.autoplay_continuous %}
  {% render 'component_swiper_navigation' %}
{% endunless %}
