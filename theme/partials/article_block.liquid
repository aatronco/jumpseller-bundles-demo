{% assign article_version = options.article_block_version %}

{% case article_version %}
  {% when 'v1' %}
    {% if options.article_block_card %}
      {% assign article_bundle_color = options.article_block_bundle_color %}
    {% else %}
      {% assign article_bundle_color = component.options.bundle_color %}
    {% endif %}
  {% when 'v2' %}
    {% assign article_bundle_color = options.article_block_bundle_color %}
{% endcase %}

{% assign data_spacing = options.article_block_spacing %}
{% if options.theme_spacing == 'none' %}
  {% assign data_spacing = false %}
{% endif %}

<article
  class="theme-block article-block{% if display_option == 'carousel' %} swiper-slide{% endif %}"
  data-version="{{ article_version }}"
  data-columns-desktop="{{ columns_desktop }}"
  data-columns-mobile="{{ columns_mobile }}"
  data-spacing="{{ data_spacing }}"
  {% if article_version == 'v1' and options.article_block_card %}
    data-card="true"
    data-card-image-padding="{{ options.article_block_card_image_padding }}"
    data-card-border="{{ options.article_block_border }}"
    data-card-shadow="{{ options.article_block_card_shadow }}"
  {% endif %}
  data-bundle-color="{{ article_bundle_color }}"
  {% if options.theme_animate %}
    data-aos-once="{% if component.options.animate %}{{ component.options.animate_repeat }}{% else %}{{ options.theme_animate_repeat }}{% endif %}"
    data-aos="{% if component.options.animate %}{{ component.options.animate_type }}{% else %}{{ options.theme_animate_type }}{% endif %}"
    data-aos-delay="{% if component.options.animate %}{{ component.options.animate_delay | times: block_index }}{% else %}{{ options.theme_animate_delay | times: block_index }}{% endif %}"
  {% endif %}
>
  <div class="theme-block__wrapper article-block__wrapper{% if columns_desktop == 1 %} flex-md-row align-items-md-center{% endif %}">
    {% if options.article_block_image %}
      <a href="{{ article_block.url }}" class="article-block__anchor" title="{% t 'Read article' %}">
        {% if article_block.images.size > 0 %}
          {% case section_width %}
            {% when '1320px' %}
              {% if columns_desktop == 3 %}
                {% assign image_desktop = article_block.images.first | thumb: '600x450' %}
              {% else %}
                {% assign image_desktop = article_block.images.first | thumb: '720x540' %}
              {% endif %}

              {% assign image_width_and_height = 'width="600" height="450"' %}
            {% else %}
              {% if columns_desktop == 1 %}
                {% assign image_desktop = article_block.images.first | thumb: '1600x686' %}
              {% else %}
                {% assign image_desktop = article_block.images.first | thumb: '800x600' %}
              {% endif %}
              {% assign image_width_and_height = 'width="800" height="600"' %}
          {% endcase %}

          <picture class="w-100 d-block">
            <source media="screen and (min-width: 576px)" srcset="{{ image_desktop }}">
            <source media="screen and (max-width: 575px)" srcset="{{ article_block.images.first | thumb: '600x450' }}">
            <img class="w-100 d-block" alt="{{ article_block.title | escape }}" src="{{ image_desktop }}" {{ image_width_and_height }} loading="lazy" decoding="auto" fetchpriority="auto">
          </picture>
        {% else %}
          <div class="aspect-ratio-rectangular theme-image-placeholder"></div>
        {% endif %}
      </a>
    {% endif %}

    {% if options.article_block_version == 'v2' %}
      {% render 'theme_hover_link', link: article_block.url, link_text: article_block.title, link_external: options.article_block_link_external %}
    {% endif %}

    <div class="{% if article_version == 'v1' %}theme-block__content {% endif %}article-block__content">
      {% for article_content in options.article_block_content_order %}
        {% case article_content %}
          {% when 'date' %}
            {% if options.article_block_date %}
              <div class="article-block__date">
                {{- article_block.date | date: format: options.article_block_date_format -}}
              </div>
            {% endif %}
          {% when 'title' %}
            <a href="{{ article_block.url }}" class="article-block__title" title="{% t 'Read' %} {{ article_block.title | escape }}">
              {{- article_block.title -}}
            </a>
          {% when 'excerpt' %}
            {% if options.article_block_excerpt %}
              <div class="article-block__excerpt check-empty">{{ article_block.body | strip_html | truncate: options.article_block_excerpt_length }}</div>
            {% endif %}
          {% when 'categories' %}
            {% if options.article_block_categories %}
              {% render 'article_categories', categories_feed: article_block.categories, align_mobile: 'start', align_desktop: 'start' %}
            {% endif %}
          {% when 'link' %}
            {% if options.article_block_button %}
              {% case options.article_block_button_type %}
                {% when 'button' %}
                  {% assign button_class = 'button--style button--' | append: options.article_block_button_appearance %}
                {% when 'text' %}
                  {% assign button_class = 'button--text' %}
              {% endcase %}
              {% if options.article_block_button_outline %}
                {% assign button_class = button_class | append: ' button--bordered' %}
              {% endif %}
              <a href="{{ article_block.url }}" class="button {{ button_class }} article-block__button" title="{% t 'Read article' %}">
                <span>{%- t "Read article" %}</span>
                {% if options.article_block_button_arrow %}<i class="ph ph-arrow-right"></i>{% endif %}
              </a>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</article>
