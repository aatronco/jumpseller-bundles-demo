{
  "name": "Banner",
  "icon": "image",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [],
  "options": {
    "link": {
      "name": "Link",
      "type": "link",
      "default": null
    },
    "link_text": {
      "name": "Link text",
      "type": "input",
      "default": "Read more",
      "visible_if": "{{ block.options.link != blank }}"
    },
    "link_external": {
      "name": "External link",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.link != blank }}"
    },
    "link_button": {
      "name": "Visible link",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ component.options.show_content and block.options.link != blank }}"
    },
    "link_button_as_text": {
      "name": "Link as text",
      "type": "checkbox",
      "help": "The link will display just as a text. If disabled, it will have a button style.",
      "default": false,
      "visible_if": "{{ component.options.show_content and block.options.link != blank and block.options.link_button }}"
    },
    "link_outline": {
      "name": "Outline style",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ component.options.show_content and block.options.link != blank and component.options.show_content and block.options.link_button }}"
    },
    "link_arrow": {
      "name": "Show arrow",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ component.options.show_content and block.options.link != blank and block.options.link_button }}"
    },
    "image_desktop": {
      "name": "Image",
      "type": "image"
    },
    "image_mobile": {
      "name": "Image (mobile)",
      "type": "image",
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "image_overlay": {
      "name": "Overlay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "",
      "visible_if": "{{ component.options.show_content and component.options.content_position == 'over' }}"
    },
    "content_alignment_x_image_desktop": {
      "name": "Horizontal position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "visible_if": "{{ component.options.show_content }}"
    },
    "content_alignment_y_image_desktop": {
      "name": "Vertical position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "visible_if": "{{ component.options.show_content }}"
    },
    "content_alignment_x_image_mobile": {
      "name": "Horizontal position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "visible_if": "{{ component.options.show_content }}"
    },
    "content_alignment_y_image_mobile": {
      "name": "Vertical position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "visible_if": "{{ component.options.show_content }}"
    },
    "subtitle": {
      "name": "Subtitle",
      "type": "input",
      "default": "",
      "placeholder": "Add a subtitle to your banner",
      "visible_if": "{{ component.options.show_content }}"
    },
    "title": {
      "name": "Title",
      "type": "input",
      "default": "Banner title",
      "visible_if": "{{ component.options.show_content }}"
    },
    "description": {
      "name": "Description",
      "type": "text",
      "default": "Here you can add some description for the banner.",
      "visible_if": "{{ component.options.show_content and component.options.content_position == 'after' }}"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "system-1",
      "pack": "color",
      "visible_if": "{{ component.options.show_content and component.options.content_position == 'over' }}"
    },
    "content_alignment_x_desktop": {
      "name": "Horizontal position",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ],
      "visible_if": "{{ component.options.show_content }}"
    },
    "content_alignment_y_desktop": {
      "name": "Vertical position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ component.options.show_content and component.options.content_position == 'over' }}"
    },
    "content_alignment_x_mobile": {
      "name": "Horizontal position",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ],
      "visible_if": "{{ component.options.show_content }}"
    },
    "content_alignment_y_mobile": {
      "name": "Vertical position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ component.options.show_content and component.options.content_position == 'over' }}"
    }
  },
  "presentation": [
    {
      "name": "Image options",
      "type": "heading",
      "before": "image_desktop"
    },
    {
      "help": "Image options for desktop devices",
      "name": "Desktop",
      "type": "heading",
      "before": "content_alignment_x_image_desktop"
    },
    {
      "help": "Image options for mobile devices",
      "name": "Mobile",
      "type": "heading",
      "before": "content_alignment_x_image_mobile"
    },
    {
      "name": "Content options",
      "type": "heading",
      "before": "subtitle"
    },
    {
      "help": "Content options for desktop devices",
      "name": "Desktop",
      "type": "heading",
      "before": "content_alignment_x_desktop"
    },
    {
      "help": "Content options for mobile devices",
      "name": "Mobile",
      "type": "heading",
      "before": "content_alignment_x_mobile"
    }
  ],
  "mode": "subcomponents",
  "blocks": []
}