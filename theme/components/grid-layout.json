{
  "name": "Grid layout",
  "icon": "grid-2-plus",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-grid-layout/).",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__account",
    "customer__login"
  ],
  "options": {
    "width": {
      "name": "Width",
      "type": "select",
      "help": "When choosing **Default**, the option defined at [Theme settings > Design > Theme styles > Maximum container width](/general/design) will be applied.",
      "default": "default",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Small",
          "value": "1320px"
        },
        {
          "label": "Medium",
          "value": "1620px"
        },
        {
          "label": "Large",
          "value": "1920px"
        },
        {
          "label": "Extra Large",
          "value": "2220px"
        },
        {
          "label": "Browser width",
          "value": "100vw"
        }
      ]
    },
    "featured": {
      "name": "Featured block",
      "type": "select",
      "help": "Allows to define which one of the blocks in your layout will display bigger than the rest.",
      "default": "first",
      "options": [
        {
          "label": "First",
          "value": "first"
        },
        {
          "label": "Middle",
          "value": "middle"
        },
        {
          "label": "Last",
          "value": "last"
        }
      ]
    },
    "spacing": {
      "name": "Space between",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_spacing != 'none' }}"
    },
    "image_ratio": {
      "name": "Ratio",
      "type": "select",
      "default": "square",
      "options": [
        {
          "label": "Landscape",
          "value": "landscape"
        },
        {
          "label": "Portrait",
          "value": "portrait"
        },
        {
          "label": "Rectangular",
          "value": "rectangular"
        },
        {
          "label": "Square",
          "value": "square"
        }
      ]
    },
    "image_crop": {
      "name": "Crop automatically",
      "type": "checkbox",
      "help": "If enabled, images for all blocks will be automatically cropped to fit the ideal dimensions within the layout.",
      "default": true
    },
    "image_transition": {
      "name": "Transition",
      "type": "select",
      "default": "zoom",
      "options": [
        {
          "label": "Grayscale on hover",
          "value": "grayscale"
        },
        {
          "label": "Grayscale on start",
          "value": "grayscale-reversed"
        },
        {
          "label": "Zoom",
          "value": "zoom"
        },
        {
          "label": "None",
          "value": "none"
        }
      ]
    },
    "show_titles": {
      "name": "Show titles",
      "type": "checkbox",
      "default": true
    },
    "title_size": {
      "name": "Size",
      "type": "select",
      "default": "small",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra Large",
          "value": "extra-large"
        }
      ],
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_weight": {
      "name": "Weight",
      "type": "slider",
      "default": 400,
      "min": 100,
      "max": 900,
      "step": 100,
      "unit": "",
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_spacing": {
      "name": "Letter spacing",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_uppercase": {
      "name": "All caps",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.show_titles }}"
    },
    "content_alignment_desktop": {
      "name": "Alignment (desktop)",
      "type": "select",
      "default": "text-md-start",
      "options": [
        {
          "label": "Left",
          "value": "text-md-start"
        },
        {
          "label": "Center",
          "value": "text-md-center"
        },
        {
          "label": "Right",
          "value": "text-md-end"
        }
      ],
      "visible_if": "{{ block.options.show_titles }}"
    },
    "content_alignment_mobile": {
      "name": "Alignment (mobile)",
      "type": "select",
      "default": "text-start",
      "options": [
        {
          "label": "Left",
          "value": "text-start"
        },
        {
          "label": "Center",
          "value": "text-center"
        },
        {
          "label": "Right",
          "value": "text-end"
        }
      ],
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_overlap": {
      "name": "Overlap titles",
      "type": "checkbox",
      "help": "If **Titles** are enabled, they will position on top of the image.",
      "default": false,
      "visible_if": "{{ block.options.show_titles }}"
    },
    "content_alignment_y": {
      "name": "Vertical position",
      "type": "select",
      "default": "end",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.show_titles and block.options.title_overlap }}"
    },
    "title_overlay": {
      "name": "Overlay",
      "type": "checkbox",
      "help": "Allows to display an **Overlay** element between the block title and the image.",
      "default": true,
      "visible_if": "{{ block.options.show_titles and block.options.title_overlap }}"
    },
    "title_overlay_opacity": {
      "name": "Overlay opacity",
      "type": "slider",
      "default": 40,
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "visible_if": "{{ block.options.show_titles and block.options.title_overlap and block.options.title_overlay }}"
    },
    "title_bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "default": "system-1",
      "pack": "color",
      "visible_if": "{{ block.options.show_titles and block.options.title_overlap }}"
    },
    "heading": {
      "name": "Enable heading",
      "type": "checkbox",
      "default": false
    },
    "heading_subtitle": {
      "name": "Subtitle",
      "type": "input",
      "default": "",
      "placeholder": "Add a subtitle to your section",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_title": {
      "name": "Title",
      "type": "input",
      "default": "Section title",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_description": {
      "name": "Description",
      "type": "text",
      "default": "",
      "placeholder": "Add a description for the header of your banner",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link": {
      "name": "Link",
      "type": "link",
      "default": null,
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link_text": {
      "name": "Link text",
      "type": "input",
      "default": "Read more",
      "visible_if": "{{ block.options.heading and block.options.heading_link }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 24,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 24,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Image options",
      "type": "heading",
      "before": "image_ratio"
    },
    {
      "name": "Title options",
      "type": "heading",
      "before": "show_titles"
    },
    {
      "name": "Overlap options",
      "type": "heading",
      "before": "content_alignment_y"
    },
    {
      "name": "Heading options",
      "type": "heading",
      "before": "heading"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "margin_top"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [
    {
      "type": "grid-block",
      "multiple": true,
      "property": "blocks"
    }
  ],
  "presets": [
    {
      "name": "Grid layout",
      "category": "Content",
      "children": [
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        }
      ]
    },
    {
      "name": "Grid layout: Landscape",
      "options": {
        "image_ratio": "landscape"
      },
      "category": "Content",
      "children": [
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        }
      ]
    },
    {
      "name": "Grid layout: No titles",
      "options": {
        "image_ratio": "rectangular",
        "show_titles": false
      },
      "category": "Content",
      "children": [
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        }
      ]
    },
    {
      "name": "Grid layout: Centered",
      "options": {
        "featured": "middle",
        "content_alignment_mobile": "text-center",
        "content_alignment_desktop": "text-md-center"
      },
      "category": "Content",
      "children": [
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        },
        {
          "type": "grid-block"
        }
      ]
    }
  ]
}