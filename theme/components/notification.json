{
  "name": "Notification",
  "icon": "bell",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-notification/).",
  "max_usage": 1,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "checkout__cart",
    "checkout__checkout",
    "customer__account",
    "customer__login"
  ],
  "options": {
    "display": {
      "name": "Display",
      "type": "select",
      "default": "content",
      "options": [
        {
          "label": "On grid",
          "value": "content"
        },
        {
          "label": "Floating",
          "value": "floating"
        }
      ]
    },
    "content_alignment_x": {
      "name": "Horizontal position",
      "type": "select",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "visible_if": "{{ block.options.display == 'floating' }}"
    },
    "content_alignment_y": {
      "name": "Vertical position",
      "type": "select",
      "default": "bottom",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "visible_if": "{{ block.options.display == 'floating' }}"
    },
    "type": {
      "name": "Type",
      "type": "select",
      "default": "info",
      "options": [
        {
          "label": "Information",
          "value": "info"
        },
        {
          "label": "Success",
          "value": "success"
        },
        {
          "label": "Warning",
          "value": "warning"
        },
        {
          "label": "Danger",
          "value": "danger"
        }
      ]
    },
    "close": {
      "name": "Show close button",
      "type": "checkbox",
      "help": "Allows to show a X icon to close the notification",
      "default": true
    },
    "icon": {
      "name": "Icon",
      "type": "ph_icon",
      "default": "ph ph-bell"
    },
    "icon_size": {
      "name": "Icon size",
      "type": "select",
      "default": "medium",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ],
      "visible_if": "{{ block.options.icon != blank }}"
    },
    "title": {
      "name": "Title",
      "type": "input",
      "default": "Notification title"
    },
    "text": {
      "name": "Text",
      "type": "text",
      "default": "Define the notification's content to display."
    },
    "link": {
      "name": "Link",
      "type": "link",
      "help": "Allows to add a link to any content of the store.",
      "default": null
    },
    "link_text": {
      "name": "Link text",
      "type": "input",
      "help": "Text that displays in the link.",
      "default": "Read more",
      "visible_if": "{{ block.options.link != blank }}"
    },
    "link_external": {
      "name": "External link",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.link != blank }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "visible_if": "{{ block.options.display == 'content' }}"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "visible_if": "{{ block.options.display == 'content' }}"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": true
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "zoom-in",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Content options",
      "type": "heading",
      "before": "icon"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "margin_top"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [],
  "presets": [
    {
      "name": "Notification",
      "category": "Information"
    },
    {
      "name": "Notification: Floating",
      "options": {
        "display": "floating"
      },
      "category": "Information"
    }
  ]
}