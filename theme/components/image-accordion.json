{
  "name": "Image Accordion",
  "icon": "rectangle-history",
  "help": "Expandable accordion of images with optional click or hover interaction.",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__account",
    "customer__login"
  ],
  "options": {
    "width": {
      "name": "Width",
      "type": "select",
      "help": "When choosing **Default**, the option defined at [Theme settings > Design > Theme styles > Maximum container width](/general/design) will be applied.",
      "default": "default",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Small",
          "value": "1320px"
        },
        {
          "label": "Medium",
          "value": "1620px"
        },
        {
          "label": "Large",
          "value": "1920px"
        },
        {
          "label": "Extra Large",
          "value": "2220px"
        },
        {
          "label": "Browser width",
          "value": "100vw"
        }
      ]
    },
    "image_height": {
      "name": "Height",
      "type": "select",
      "default": "medium",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ]
    },
    "orientation": {
      "name": "Orientation",
      "type": "select",
      "help": "On mobile, the orientation is always Vertical.",
      "default": "horizontal",
      "options": [
        {
          "label": "Horizontal",
          "value": "horizontal"
        },
        {
          "label": "Vertical",
          "value": "vertical"
        }
      ]
    },
    "event": {
      "name": "Interaction",
      "type": "select",
      "help": "On mobile, the event to open an item is always with a tap.",
      "default": "hover",
      "options": [
        {
          "label": "Hover",
          "value": "hover"
        },
        {
          "label": "Click",
          "value": "click"
        }
      ]
    },
    "spacing_edges": {
      "name": "Left and right space",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ options.theme_spacing != 'none' }}"
    },
    "show_content": {
      "name": "Show content",
      "type": "checkbox",
      "default": true
    },
    "first_open": {
      "name": "Open first item",
      "type": "checkbox",
      "default": true
    },
    "spacing": {
      "name": "Space between",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_spacing != 'none' }}"
    },
    "corners": {
      "name": "Rounded corners",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_corners_style != 'rectangular' }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Accordion settings",
      "type": "heading",
      "before": "width"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "margin_top"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [
    {
      "type": "image-accordion-item",
      "multiple": true,
      "property": "blocks"
    }
  ],
  "presets": [
    {
      "name": "Image Accordion: First item open",
      "options": {
        "first_open": true
      },
      "category": "Content",
      "children": [
        {
          "type": "image-accordion-item",
          "options": {
            "text": "Short description for this accordion panel.",
            "title": "Image accordion 1 title"
          }
        },
        {
          "type": "image-accordion-item",
          "options": {
            "text": "Short description for this accordion panel.",
            "title": "Image accordion 2 title"
          }
        },
        {
          "type": "image-accordion-item",
          "options": {
            "text": "Short description for this accordion panel.",
            "title": "Image accordion 3 title"
          }
        }
      ]
    },
    {
      "name": "Image Accordion: Image only",
      "options": {
        "first_open": false,
        "show_content": false
      },
      "category": "Content",
      "children": [
        {
          "type": "image-accordion-item"
        },
        {
          "type": "image-accordion-item"
        },
        {
          "type": "image-accordion-item"
        }
      ]
    },
    {
      "name": "Image Accordion: Vertical display",
      "options": {
        "orientation": "vertical"
      },
      "category": "Content",
      "children": [
        {
          "type": "image-accordion-item",
          "options": {
            "text": "Short description for this accordion panel.",
            "title": "Image accordion 1 title"
          }
        },
        {
          "type": "image-accordion-item",
          "options": {
            "text": "Short description for this accordion panel.",
            "title": "Image accordion 2 title"
          }
        },
        {
          "type": "image-accordion-item",
          "options": {
            "text": "Short description for this accordion panel.",
            "title": "Image accordion 3 title"
          }
        }
      ]
    }
  ]
}