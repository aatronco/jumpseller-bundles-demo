          "type": "information-card"
        },
        {
          "type": "information-card"
        }
      ]
    },
    {
      "name": "Information cards: No icons",
      "options": {
        "icon": false
      },
      "category": "Information",
      "children": [
        {
          "type": "information-card"
        },
        {
          "type": "information-card"
        },
        {
          "type": "information-card"
        }
      ]
    }
  ]
}