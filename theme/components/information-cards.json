          "type": "information-card",
          "options": {
            "icon": "ph ph-money",
            "title": "Card title",
            "back_text": "Card description for the back side.",
            "front_text": "Card description for the front side."
          }
        },
        {
          "type": "information-card",
          "options": {
            "icon": "ph ph-percent",
            "title": "Card title",
            "back_text": "Card description for the back side.",
            "front_text": "Card description for the front side."
          }
        }
      ]
    },
    {
      "name": "Information cards: Big icon",
      "options": {
        "icon_size": "medium",
        "icon_shape": "rounded"
      },
      "category": "Information",
      "children": [
        {
          "type": "information-card"
