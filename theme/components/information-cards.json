        },
        {
          "type": "information-card"
        }
      ]
    },
    {
      "name": "Information cards: 4 columns",
      "options": {
        "columns_desktop": "4"
      },
      "category": "Information",
      "children": [
        {
          "type": "information-card"
        },
        {
          "type": "information-card"
        },
