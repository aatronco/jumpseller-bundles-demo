{% if component.options.width == 'default' %}
  {% assign footer_width = options.theme_width %}
{% else %}
  {% assign footer_width = component.options.width %}
{% endif %}

{% assign align_desktop = component.options.align_desktop %}

{% capture footer_payment_methods -%}
  {%- for partner in store.payment_methods_formatted -%}
    {{- partner.name | escape -}}
  {%- endfor -%}
{%- endcapture %}
{% capture footer_partners -%}
  {%- for partner in component.options.partners -%}
    {{- partner.name | escape -}}
  {%- endfor -%}
{%- endcapture %}

{% if footer_payment_methods != blank or footer_partners != blank %}
  {% assign has_payments = true %}
{% else %}
  {% assign has_payments = false %}
{% endif %}

{% assign has_scroll = component.options.scroll %}
{% assign scroll_position = component.options.scroll_position %}
{% capture scroll_render %}
  {% render 'footer_scroll', scroll_position: scroll_position %}
{% endcapture %}

<style>
  .footer {
    --theme-max-width: {{ footer_width }};
    --footer-title-transform: {% if component.options.titles_uppercase %}uppercase{% else %}inherit{% endif %};
  }
</style>

{% capture footer_copyright %}
  <div class="footer__copyright">
    <i class="ph ph-copyright"></i> {{ 'now' | date: '%Y' }}
    {{ options.theme_store_name | default: store.name }}.<br>
    {%- t "All Rights Reserved" -%}
    . {{ powered_by -}}
  </div>
{% endcapture %}

<footer
  class="theme-section footer {{ component.options.align_mobile }} {{ align_desktop }}"
  data-titles-underline="{{ component.options.titles_underline }}"
  data-bundle-color="{{ component.options.bundle_color }}"
  {{ component.attributes }}
>
  <div class="theme-section__container footer__container">
    {% if has_scroll and scroll_position == 'start' %}
      {{ scroll_render }}
    {% endif %}

    <div class="row align-items-start justify-content-start footer__wrapper">
      {% for child in component.children %}
        {% case child.property %}
          {% when 'footer-about' %}
            {% render 'components/footer-about', footer-about: child %}
          {% when 'footer-menu-1' %}
            {% render 'components/footer-menu-1', footer-menu-1: child %}
          {% when 'footer-menu-2' %}
            {% render 'components/footer-menu-2', footer-menu-2: child %}
          {% when 'footer-contact-information' %}
            {% render 'components/footer-contact-information', footer-contact-information: child %}
          {% when 'footer-locations' %}
            {% render 'components/footer-locations', footer-locations: child %}
          {% when 'footer-divider' %}
            {% render 'components/footer-divider', footer-divider: child %}
        {% endcase %}
      {% endfor %}
    </div>

    <div class="row align-items-center footer__wrapper">
      <div class="col-12 order-1 footer__column">
        <hr class="footer__divider">
      </div>

      {% if has_payments %}
        <div class="col-12 col-md order-2{% unless align_desktop == 'text-md-end' %} order-md-3{% endunless %} footer__column">
          <div class="d-flex align-items-center justify-content-start justify-content-md-end flex-wrap">
            {% for partner in component.options.partners %}
              <div class="footer__payment">
                <img
                  src="{{ partner.badge }}"
                  alt="{{ partner.name | escape }}"
                  height="30"
                  width="56"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                >
              </div>
            {% endfor %}

            {% if component.options.store_payments %}
              {% for partner in store.payment_methods_formatted %}
                <div class="footer__payment">
                  <img
                    {% if partner.name contains ', ' %}
                      data-bs-toggle="tooltip"
                      data-bs-placement="top"
                      data-bs-html="true"
                      data-bs-title="{% t 'Methods available' %}:<br>&#8226;{{- partner.name | replace: ', ', '<br>&#8226;' -}}"
                    {% endif %}
                    src="{{ partner.badge }}"
                    alt="{{ partner.name | escape }}"
                    height="30"
                    width="56"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  >
                </div>
              {% endfor %}
            {% endif %}

            {% if component.options.store_payments_options %}
              {% for partner in store.payment_options_images %}
                <div class="footer__payment">
                  <img
                    src="{{ partner }}"
                    alt="{{ partner | escape }}"
                    height="30"
                    width="56"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  >
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% case align_desktop %}
        {% when 'text-md-center' %}
          <div class="col-12 order-3 footer__column">
            {{ footer_copyright }}
          </div>
        {% else %}
          {% if has_payments %}
            <div class="col-12 col-md-auto order-3 order-md-2 footer__column">
              {{ footer_copyright }}
            </div>
          {% else %}
            <div class="col-12{% unless align_desktop == 'text-md-end' %} order-2 text-md-center{% endunless %} footer__column">
              {{ footer_copyright }}
            </div>
          {% endif %}
      {% endcase %}
    </div>

    {% if has_scroll and scroll_position == 'end' %}
      {{ scroll_render }}
    {% endif %}
  </div>
  <!-- end .footer__container -->
</footer>
<!-- end .footer -->
