{
  "name": "Block",
  "icon": "square",
  "help": "For more information on how this component work, visit the theme documentation.",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [],
  "options": {
    "permalink": {
      "name": "Category",
      "type": "category",
      "help": "Mandatory. Allows to select a **Category** from the list of created categories in `Products > Categories`."
    },
    "title": {
      "name": "Title",
      "type": "input",
      "default": "",
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "show_description": {
      "name": "Show description",
      "type": "checkbox",
      "help": "This will only be displayed on desktop devices and will hide on mobile, when `Position` is `Over the image` at the main component settings.",
      "default": true,
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "description": {
      "name": "Custom description",
      "type": "text",
      "default": "",
      "visible_if": "{{ block.options.permalink != blank and block.options.show_description }}"
    },
    "link_text": {
      "name": "Link text",
      "type": "input",
      "default": "See products",
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "link_external": {
      "name": "External link",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "link_arrow": {
      "name": "Arrow in title",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "show_link_text": {
      "name": "Show link as text",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "image_desktop": {
      "name": "Custom image",
      "type": "image",
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "image_mobile": {
      "name": "Custom image (mobile)",
      "type": "image",
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "image_overlay": {
      "name": "Overlay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "",
      "visible_if": "{{ block.options.image_desktop.url != blank and component.options.content_position == 'over' }}"
    },
    "icon": {
      "name": "Icon",
      "type": "image",
      "visible_if": "{{ block.options.permalink != blank }}"
    },
    "icon_size": {
      "name": "Size",
      "type": "slider",
      "default": 30,
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "visible_if": "{{ block.options.permalink != blank and block.options.icon.url != blank }}"
    },
    "icon_overlay": {
      "name": "Overlay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "",
      "visible_if": "{{ block.options.permalink != blank and component.options.content_position == 'below' and block.options.icon != blank }}"
    },
    "icon_bundle_color": {
      "name": "Overlay color",
      "type": "bundle",
      "default": "system-1",
      "pack": "color",
      "visible_if": "{{ block.options.permalink != blank and component.options.content_position == 'below' and block.options.icon != blank }}"
    },
    "content_alignment_x_icon": {
      "name": "Horizontal position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.permalink != blank and block.options.icon.url != blank and component.options.content_position == 'below' }}"
    },
    "content_alignment_y_icon": {
      "name": "Vertical position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.permalink != blank and block.options.icon.url != blank and component.options.content_position == 'below' }}"
    },
    "align_desktop": {
      "name": "Alignment (desktop)",
      "type": "select",
      "default": "text-md-start",
      "options": [
        {
          "label": "Left",
          "value": "text-md-start"
        },
        {
          "label": "Center",
          "value": "text-md-center"
        },
        {
          "label": "Right",
          "value": "text-md-end"
        }
      ],
      "visible_if": "{{ block.options.permalink != blank and component.options.content_position == 'over' }}"
    },
    "align_mobile": {
      "name": "Alignment (mobile)",
      "type": "select",
      "default": "text-start",
      "options": [
        {
          "label": "Left",
          "value": "text-start"
        },
        {
          "label": "Center",
          "value": "text-center"
        },
        {
          "label": "Right",
          "value": "text-end"
        }
      ],
      "visible_if": "{{ block.options.permalink != blank and component.options.content_position == 'over' }}"
    },
    "content_alignment_y_content": {
      "name": "Vertical content position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.permalink != blank and component.options.content_position == 'over' }}"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "system-1",
      "pack": "color",
      "visible_if": "{{ block.options.permalink != blank and component.options.content_position == 'over' }}"
    }
  },
  "presentation": [
    {
      "name": "Link options",
      "type": "heading",
      "before": "link_text"
    },
    {
      "name": "Image options",
      "type": "heading",
      "before": "image_desktop"
    },
    {
      "name": "Icon options",
      "type": "heading",
      "before": "icon"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "align_desktop"
    }
  ],
  "mode": "subcomponents",
  "blocks": []
}