{% assign section_id = 'theme-section-' | append: component.id %}

{% assign column_width = 'col-12' %}
{% assign column_position = 'justify-content-start' %}

{% if component.options.enable_width %}
  {% case component.options.width %}
    {% when 'large' %}
      {% assign column_width = column_width | append: ' col-md-11 col-lg-10' %}
    {% when 'medium' %}
      {% assign column_width = column_width | append: ' col-md-9 col-lg-8' %}
    {% when 'small' %}
      {% assign column_width = column_width | append: ' col-md-7 col-lg-6' %}
  {% endcase %}

  {% assign column_position = 'justify-content-' | append: component.options.content_alignment_x %}
{% endif %}

{% assign link = component.options.link %}
{% capture link_text_default %}{% t "Read more" %}{% endcapture %}
{% assign link_text = component.options.link_text | default: link_text_default %}

{% assign align_desktop = component.options.align_desktop %}
{% assign align_mobile = component.options.align_mobile %}
{% assign align_items_desktop = align_desktop | replace: 'text-md-', 'align-items-md-' %}
{% assign align_items_mobile = align_mobile | replace: 'text-', 'align-items-' %}

<style>
  #{{ section_id }} {
    {% assign title_size_desktop = component.options.title_size_desktop | append: 'px' %}
    {% assign title_size_mobile = component.options.title_size_mobile | append: 'px' %}

    --theme-max-width: {{ options.theme_width }};
    --section-margin-top: {{ component.options.margin_top }}px;
    --section-margin-bottom: {{ component.options.margin_bottom }}px;

    {% if component.options.title_size == 'custom' %}
      --title-size-desktop: {{ title_size_desktop }};
      --title-size-mobile: {{ title_size_mobile }};
      --subtitle-size-desktop: {{ component.options.subtitle_size_desktop }}px;
      --subtitle-size-mobile: {{ component.options.subtitle_size_mobile }}px;
    {% else %}
      --title-size-desktop: var(--title-size-{{ component.options.title_size }}-desktop);
      --title-size-mobile: var(--title-size-{{ component.options.title_size }}-mobile);
      --subtitle-size-desktop: calc(var(--title-size-{{ component.options.title_size }}-desktop) * var(--subtitle-size-desktop-number));
      --subtitle-size-mobile: calc(var(--title-size-{{ component.options.title_size }}-mobile) * var(--subtitle-size-mobile-number));
    {% endif %}
      --title-weight: {{ component.options.title_weight }};
      --title-spacing: {{ component.options.title_spacing }}px;
      --title-text-transform: {% if component.options.title_uppercase %}uppercase{% else %}initial{% endif %};
      --subtitle-weight: {{ component.options.subtitle_weight }};
      --subtitle-spacing: {{ component.options.subtitle_spacing }}px;
      --subtitle-text-transform: {% if component.options.subtitle_uppercase %}uppercase{% else %}initial{% endif %};
    {% case component.options.text_size %}
      {% when 'custom' %}
        --description-size-desktop: {{ component.options.text_size_desktop }}px;
        --description-size-mobile: {{ component.options.text_size_mobile }}px;
      {% else %}
        --description-size-desktop: var(--description-size-{{ component.options.text_size }}-desktop);
        --description-size-mobile: var(--description-size-{{ component.options.text_size }}-mobile);
    {% endcase %}
  }
</style>

<section
  id="{{ section_id }}"
  class="container-fluid theme-section"
  data-bundle-color="{{ component.options.bundle_color }}"
  {% if options.theme_animate %}
    data-aos-once="{% if component.options.animate %}{{ component.options.animate_repeat }}{% else %}{{ options.theme_animate_repeat }}{% endif %}"
    data-aos="{% if component.options.animate %}{{ component.options.animate_type }}{% else %}{{ options.theme_animate_type }}{% endif %}"
    data-aos-delay="{% if component.options.animate %}{{ component.options.animate_delay }}{% else %}{{ options.theme_animate_delay }}{% endif %}"
  {% endif %}
  {{ component.attributes }}
>
  <div class="container container--adjust theme-section__container">
    <div class="row align-items-start {{ column_position }} theme-section__content">
      <div class="{{ column_width }} {{ align_mobile }} {{ align_desktop }} theme-section__column theme-section__column--no-margin">
        <div class="theme-section__content-wrapper {{ align_items_mobile }} {{ align_items_desktop }}">
          <div class="theme-section__subtitle check-empty" {{ component.attributes.textfield.subtitle }}>{{ component.options.subtitle }}</div>

          <h3 class="theme-section__title check-empty" {{ component.attributes.textfield.title }}>{{ component.options.title }}</h3>

          <div class="theme-section__description check-empty" {{ component.attributes.textfield.text }}>{{ component.options.text | newline_to_br }}</div>

          {% if link != blank %}
            <a
              href="{{ link }}"
              class="button button--style button--secondary{% if component.options.link_outline %} button--bordered{% endif %} theme-section__button"
              title="{{ link_text }}"
              {% if options.theme_button_hover %}
                data-button-hover="{{ options.theme_button_hover_style }}"
              {% endif %}
              {% if component.options.link_external %}
                target="_blank"
              {% endif %}
            >
              <span {{ component.attributes.textfield.link_text }}>{{ link_text }}</span>
              {%- if component.options.link_arrow %} <i class="ph ph-arrow-right"></i>{% endif %}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
