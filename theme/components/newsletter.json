{
  "name": "Newsletter",
  "icon": "paper-plane",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-newsletter/).",
  "max_usage": 1,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__account",
    "customer__login"
  ],
  "options": {
    "title": {
      "name": "Title",
      "type": "input",
      "default": "Subscribe to our Newsletter"
    },
    "description": {
      "name": "Description",
      "type": "text",
      "default": "You can add a text or description to encourage customers to subscribe."
    },
    "placeholder": {
      "name": "Email field placeholder",
      "type": "input",
      "default": "Enter your email here..."
    },
    "button": {
      "name": "Button text",
      "type": "input",
      "default": "Subscribe"
    },
    "disclaimer": {
      "name": "Disclaimer text",
      "type": "text",
      "help": "Text that can be displayed after the Newsletter form",
      "default": "",
      "placeholder": "Add a disclaimer to provide more information about the Newsletter"
    },
    "image_desktop": {
      "name": "Image",
      "type": "image"
    },
    "image_mobile": {
      "name": "Image (mobile)",
      "type": "image",
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "image_overlay": {
      "name": "Overlay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "",
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "content_alignment_x_image_desktop": {
      "name": "Horizontal",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "content_alignment_y_image_desktop": {
      "name": "Vertical",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "content_alignment_x_image_mobile": {
      "name": "Horizontal",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "content_alignment_y_image_mobile": {
      "name": "Vertical",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "content_alignment_x": {
      "name": "Content alignment",
      "type": "select",
      "help": "Allows to define the alignment for the component content. This will also affect the position of the form.",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "system-1",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Form options",
      "type": "heading",
      "before": "placeholder"
    },
    {
      "name": "Background image",
      "type": "heading",
      "before": "image_desktop"
    },
    {
      "help": "Background image position options for desktop devices",
      "name": "Desktop",
      "type": "heading",
      "before": "content_alignment_x_image_desktop"
    },
    {
      "help": "Background image position options for mobile devices",
      "name": "Mobile",
      "type": "heading",
      "before": "content_alignment_x_image_mobile"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "content_alignment_x"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Social"
    }
  ]
}