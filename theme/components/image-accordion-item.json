        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ]
    },
    "text_alignment_mobile": {
      "name": "Alignment",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "content_alignment_x_mobile": {
      "name": "Horizontal position",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "content_alignment_y_mobile": {
      "name": "Vertical position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ]
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "system-1",
      "pack": "color"
    }
  },
  "presentation": [
    {
      "help": "Image options for desktop devices",
      "name": "Desktop",
      "type": "heading",
      "before": "content_alignment_x_image_desktop"
    },
    {
      "help": "Image options for mobile devices",
      "name": "Mobile",
      "type": "heading",
      "before": "content_alignment_x_image_mobile"
    },
    {
      "name": "Link options",
      "type": "heading",
      "before": "link"
    },
    {
