    "text": {
      "name": "Text",
      "type": "text",
      "help": "Mandatory",
      "default": "This is the slide text"
    },
    "link": {
      "name": "Link",
      "type": "link",
      "help": "Allows to add a link to any content of the store.",
      "default": null
    },
    "link_text": {
      "name": "Link text",
      "type": "input",
      "help": "Text that displays in the link.",
