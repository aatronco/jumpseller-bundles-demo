{
  "name": "Product mapping",
  "icon": "crosshairs",
  "help": "Allows to add an image in which you can position and mark products from your store.",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__account",
    "customer__login"
  ],
  "options": {
    "width": {
      "name": "Width",
      "type": "select",
      "help": "When choosing **Default**, the option defined at [Theme settings > Design > Theme styles > Maximum container width](/general/design) will be applied.",
      "default": "default",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Small",
          "value": "1320px"
        },
        {
          "label": "Medium",
          "value": "1620px"
        },
        {
          "label": "Large",
          "value": "1920px"
        },
        {
          "label": "Extra Large",
          "value": "2220px"
        },
        {
          "label": "Browser width",
          "value": "100vw"
        }
      ]
    },
    "spacing": {
      "name": "Left and right space",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ options.theme_spacing != 'none' }}"
    },
    "corners": {
      "name": "Rounded corners",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_corners_style != 'rectangular' }}"
    },
    "image_desktop": {
      "name": "Image",
      "type": "image"
    },
    "image_mobile": {
      "name": "Image (mobile)",
      "type": "image",
      "visible_if": "{{ block.options.image_desktop.url != blank }}"
    },
    "marker_size": {
      "name": "Size",
      "type": "select",
      "default": "small",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Custom",
          "value": "custom"
        }
      ]
    },
    "marker_size_desktop": {
      "name": "Size (desktop)",
      "type": "slider",
      "default": 32,
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.marker_size == 'custom' }}"
    },
    "marker_size_mobile": {
      "name": "Size (mobile)",
      "type": "slider",
      "default": 28,
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.marker_size == 'custom' }}"
    },
    "marker_corners": {
      "name": "Style",
      "type": "select",
      "default": "circular",
      "options": [
        {
          "label": "Circular",
          "value": "circular"
        },
        {
          "label": "Rounded",
          "value": "rounded"
        },
        {
          "label": "Rectangular",
          "value": "rectangular"
        }
      ]
    },
    "marker_color": {
      "name": "Background",
      "type": "color",
      "default": "#FFFFFF"
    },
    "marker_animation": {
      "name": "Animation",
      "type": "select",
      "default": "always",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "On hover",
          "value": "hover"
        },
        {
          "label": "Always",
          "value": "always"
        }
      ]
    },
    "product_quickview": {
      "name": "Enable Quick view",
      "type": "checkbox",
      "default": true
    },
    "product_corners": {
      "name": "Style",
      "type": "select",
      "default": "rounded-small",
      "options": [
        {
          "label": "Rounded small",
          "value": "rounded-small"
        },
        {
          "label": "Rounded large",
          "value": "rounded-large"
        },
        {
          "label": "Rectangular",
          "value": "rectangular"
        }
      ],
      "visible_if": "{{ block.options.product_quickview == false }}"
    },
    "content_alignment_y_product": {
      "name": "Vertical alignment",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.product_quickview == false }}"
    },
    "product_bundle_color": {
      "name": "Product content colors",
      "type": "bundle",
      "default": "default",
      "pack": "color",
      "visible_if": "{{ block.options.product_quickview == false }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 32,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 32,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Image options",
      "type": "heading",
      "before": "image_desktop"
    },
    {
      "name": "Markers options",
      "type": "heading",
      "before": "marker_size"
    },
    {
      "help": "When **Quick view** is disabled, most of the styles applied to products will consider what was defined at [Theme settings > Product blocks](/general/product-block).",
      "name": "Product options",
      "type": "heading",
      "before": "product_quickview"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "margin_top"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "children",
  "blocks": [
    {
      "type": "product-mapping-item",
      "multiple": true,
      "property": "items"
    }
  ],
  "presets": [
    {
      "name": "Product mapping",
      "category": "Products",
      "children": [
        {
          "type": "product-mapping-item",
          "options": {
            "position_top": 10,
            "position_left": 10,
            "position_top_mobile": 15,
            "position_left_mobile": 15
          }
        },
        {
          "type": "product-mapping-item",
          "options": {
            "position_top": 30,
            "position_left": 30,
            "position_top_mobile": 35,
            "position_left_mobile": 35
          }
        },
        {
          "type": "product-mapping-item",
          "options": {
            "position_top": 50,
            "position_left": 50,
            "position_top_mobile": 55,
            "position_left_mobile": 55
          }
        }
      ]
    }
  ]
}