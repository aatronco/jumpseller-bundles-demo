{
  "name": "Marquee",
  "icon": "infinity",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=support/component-marquee/).",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__account",
    "customer__login"
  ],
  "options": {
    "width": {
      "name": "Width",
      "type": "select",
      "help": "When choosing **Default**, the option defined at [Theme settings > Design > Theme styles > Maximum container width](/general/design) will be applied.",
      "default": "100vw",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Small",
          "value": "1320px"
        },
        {
          "label": "Medium",
          "value": "1620px"
        },
        {
          "label": "Large",
          "value": "1920px"
        },
        {
          "label": "Extra Large",
          "value": "2220px"
        },
        {
          "label": "Browser width",
          "value": "100vw"
        }
      ]
    },
    "content_alignment_x_desktop": {
      "name": "Alignment (desktop)",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "content_alignment_x_mobile": {
      "name": "Alignment (mobile)",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "content_alignment_x_direction": {
      "name": "Direction",
      "type": "select",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    "speed": {
      "name": "Speed",
      "type": "slider",
      "default": 10000,
      "min": 1000,
      "max": 20000,
      "step": 1000,
      "unit": "ms"
    },
    "clones_size": {
      "name": "Clone amount",
      "type": "slider",
      "default": 3,
      "min": 1,
      "max": 7,
      "step": 1,
      "unit": ""
    },
    "equal_width": {
      "name": "Equalize items width",
      "type": "checkbox",
      "default": true
    },
    "stop_hover": {
      "name": "Stop on hover",
      "type": "checkbox",
      "default": true
    },
    "image_display": {
      "name": "Display",
      "type": "select",
      "default": "thumb",
      "options": [
        {
          "label": "Crop",
          "value": "thumb"
        },
        {
          "label": "Resize",
          "value": "resize"
        }
      ]
    },
    "image_size": {
      "name": "Size",
      "type": "select",
      "default": "medium",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Custom",
          "value": "custom"
        }
      ]
    },
    "image_size_desktop": {
      "name": "Size (desktop)",
      "type": "slider",
      "default": 75,
      "min": 10,
      "max": 300,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.image_size == 'custom' }}"
    },
    "image_size_mobile": {
      "name": "Size (mobile)",
      "type": "slider",
      "default": 65,
      "min": 10,
      "max": 300,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.image_size == 'custom' }}"
    },
    "image_ratio": {
      "name": "Ratio",
      "type": "select",
      "default": "square",
      "options": [
        {
          "label": "Landscape",
          "value": "landscape"
        },
        {
          "label": "Portrait",
          "value": "portrait"
        },
        {
          "label": "Rectangular",
          "value": "rectangular"
        },
        {
          "label": "Square",
          "value": "square"
        }
      ]
    },
    "image_shape": {
      "name": "Shape",
      "type": "select",
      "default": "rectangular",
      "options": [
        {
          "label": "Rectangular",
          "value": "rectangular"
        },
        {
          "label": "Rounded",
          "value": "rounded"
        },
        {
          "label": "Circular",
          "value": "circular"
        }
      ]
    },
    "show_titles": {
      "name": "Show titles",
      "type": "checkbox",
      "default": true
    },
    "title_font": {
      "name": "Font",
      "type": "select",
      "default": "main",
      "options": [
        {
          "label": "Main",
          "value": "main"
        },
        {
          "label": "Secondary",
          "value": "secondary"
        }
      ],
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_size": {
      "name": "Size",
      "type": "select",
      "default": "small",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Custom",
          "value": "custom"
        }
      ],
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_size_desktop": {
      "name": "Size (desktop)",
      "type": "slider",
      "default": 16,
      "min": 8,
      "max": 160,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.show_titles and block.options.title_size == 'custom' }}"
    },
    "title_size_mobile": {
      "name": "Size (mobile)",
      "type": "slider",
      "default": 12,
      "min": 8,
      "max": 150,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.show_titles and block.options.title_size == 'custom' }}"
    },
    "title_weight": {
      "name": "Weight",
      "type": "slider",
      "default": 400,
      "min": 100,
      "max": 900,
      "step": 100,
      "unit": "",
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_spacing": {
      "name": "Letter spacing",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.show_titles }}"
    },
    "title_uppercase": {
      "name": "All caps",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.show_titles }}"
    },
    "show_mask": {
      "name": "Show mask",
      "type": "checkbox",
      "default": true
    },
    "spacing": {
      "name": "Left and right space",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ options.theme_spacing != 'none' }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 24,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 24,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Behavior",
      "type": "heading",
      "before": "content_alignment_x_direction"
    },
    {
      "name": "Image options",
      "type": "heading",
      "before": "image_display"
    },
    {
      "name": "Title options",
      "type": "heading",
      "before": "show_titles"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "show_mask"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [
    {
      "type": "marquee-item",
      "multiple": true,
      "property": "items"
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "category": "Content",
      "children": [
        {
          "type": "marquee-item"
        },
        {
          "type": "marquee-item"
        },
        {
          "type": "marquee-item"
        },
        {
          "type": "marquee-item"
        },
        {
          "type": "marquee-item"
        }
      ]
    }
  ]
}