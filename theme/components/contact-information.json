{
  "name": "Contact information",
  "icon": "circle-info",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-contact-information/).",
  "max_usage": 1,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error"
  ],
  "options": {
    "heading": {
      "name": "Enable heading",
      "type": "checkbox",
      "default": true
    },
    "heading_subtitle": {
      "name": "Subtitle",
      "type": "input",
      "default": "",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_title": {
      "name": "Title",
      "type": "input",
      "default": "Contact us",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_description": {
      "name": "Description",
      "type": "text",
      "default": "Here you can find all the available channels in which you can reach at us.",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link": {
      "name": "Link",
      "type": "link",
      "default": null,
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link_text": {
      "name": "Link text",
      "type": "input",
      "default": "Read more",
      "visible_if": "{{ block.options.heading and block.options.heading_link != blank }}"
    },
    "show_email": {
      "name": "Email",
      "type": "checkbox",
      "default": false
    },
    "email_type": {
      "name": "Email type",
      "type": "select",
      "default": "contact",
      "options": [
        {
          "label": "Contact",
          "value": "contact"
        },
        {
          "label": "Location",
          "value": "location"
        }
      ],
      "visible_if": "{{ block.options.show_email }}"
    },
    "show_phone": {
      "name": "Phone",
      "type": "checkbox",
      "default": true
    },
    "show_whatsapp": {
      "name": "WhatsApp number",
      "type": "checkbox",
      "default": true
    },
    "show_address": {
      "name": "Store's main address",
      "type": "checkbox",
      "default": true
    },
    "show_social": {
      "name": "Social media links",
      "type": "checkbox",
      "default": true
    },
    "content_alignment_x": {
      "name": "Alignment",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "titles_uppercase": {
      "name": "Titles in all caps",
      "type": "checkbox",
      "default": false
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "help": "Allows to define which contact details will be displayed.",
      "name": "Information",
      "type": "heading",
      "before": "show_email"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "content_alignment_x"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [],
  "presets": [
    {
      "name": "Contact information",
      "category": "Contact"
    }
  ]
}