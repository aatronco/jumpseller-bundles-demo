{
  "name": "Title",
  "icon": "text",
  "max_usage": 1,
  "required": true,
  "tag": "div",
  "classes": "",
  "templates_in": [],
  "options": {
    "mobile_first": {
      "name": "Show before product gallery on Mobile",
      "type": "checkbox",
      "default": true
    },
    "title_size": {
      "name": "Custom size",
      "type": "checkbox",
      "help": "Allows to customize the size for all product page titles across the theme. If not enabled, what's defined at `Theme Settings > Headings > Titles` will be applied.",
      "default": false
    },
    "title_size_desktop": {
      "name": "Size (desktop)",
      "type": "slider",
      "default": 32,
      "min": 10,
      "max": 160,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.title_size }}"
    },
    "title_size_mobile": {
      "name": "Size (mobile)",
      "type": "slider",
      "default": 24,
      "min": 10,
      "max": 150,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.options.title_size }}"
    },
    "uppercase": {
      "name": "All caps",
      "type": "checkbox",
      "default": false
    }
  },
  "mode": "subcomponents",
  "blocks": []
}