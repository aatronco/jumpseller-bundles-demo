{% assign section_id = 'theme-section-' | append: component.id %}
{% assign section_align = component.options.content_alignment_x %}

{% if section_align == 'center' %}
  {% assign section_classname = 'col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 col-xl-4 offset-xl-4' %}
{% else %}
  {% assign section_classname = 'col-12 col-md-6' %}
{% endif %}

{% capture button_text %}{% t "Subscribe" %}{% endcapture %}

{% assign image_desktop = component.options.image_desktop.url %}
{% assign image_mobile = component.options.image_mobile.url | default: image_desktop %}
{% assign image_alt = component.options.image_mobile.alt | default: component.options.image_desktop.alt | default: component.options.title | default: options.theme_store_name | default: store.name | escape %}
{% assign image_width_and_height = component.options.image_desktop.attributes.width_and_height | default: 'width="auto" height="auto"' %}

{% capture background_image %}
  <div class="theme-section__media">
    {% if image_desktop != blank %}
      <div class="theme-section__overlay"></div>

      <picture class="theme-section__picture">
        <source media="screen and (min-width: 576px)" srcset="{{ image_desktop }}">
        <source media="screen and (max-width: 575px)" srcset="{{ image_mobile }}">
        <img
          src="{{ image_desktop }}"
          alt="{{ image_alt }}"
          class="theme-section__image theme-newsletter__image}"
          {{ image_width_and_height }}
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        >
      </picture>
    {% else %}
      <div class="theme-image-placeholder"></div>
    {% endif %}
  </div>
{% endcapture %}

<style>
  #{{ section_id }} {
    --theme-max-width: {{ options.theme_width }};
    --section-margin-top: {{ component.options.margin_top }}px;
    --section-margin-bottom: {{ component.options.margin_bottom }}px;
    {% if image_desktop != blank or image_mobile != blank %}
      --theme-image-position-desktop: {{ component.options.content_alignment_x_image_desktop }} {{ component.options.content_alignment_y_image_desktop }};
  	  --theme-image-position-mobile: {{ component.options.content_alignment_x_image_mobile }} {{ component.options.content_alignment_y_image_mobile }};
      --theme-overlay-opacity: {{ component.options.image_overlay | divided_by: 100.00 }};
    {% endif %}
  }
</style>

<section
  id="{{ section_id }}"
  class="container-fluid text-{{ section_align }} theme-section"
  data-bundle-color="{{ component.options.bundle_color }}"
  {% if options.theme_animate %}
    data-aos-once="{% if component.options.animate %}{{ component.options.animate_repeat }}{% else %}{{ options.theme_animate_repeat }}{% endif %}"
    data-aos="{% if component.options.animate %}{{ component.options.animate_type }}{% else %}{{ options.theme_animate_type }}{% endif %}"
    data-aos-delay="{% if component.options.animate %}{{ component.options.animate_delay }}{% else %}{{ options.theme_animate_delay }}{% endif %}"
  {% endif %}
  {{ component.attributes }}
>
  <div class="container container--adjust theme-section__container">
    <div class="row align-items-center theme-section__content">
      <div class="{{ section_classname }}{% if section_align == 'end' %} order-md-2{% endif %} theme-section__column theme-section__column--no-margin">
        <div class="theme-section__content-wrapper theme-section__content-wrapper--no-padding">
          <h3 class="theme-section__title check-empty" {{ component.attributes.textfield.title }}>
            {{- component.options.title -}}
          </h3>

          <div class="theme-section__description check-empty" {{ component.attributes.textfield.description }}>
            {{- component.options.description -}}
          </div>
        </div>
      </div>
      <!-- end .theme-section__column -->

      {% if section_align == 'center' %}
        <div class="w-100"></div>
      {% endif %}

      <newsletter-form
        id="newsletter-form-{{ component.id }}"
        class="{{ section_classname }}{% if section_align == 'end' %} order-md-1{% endif %} theme-newsletter theme-section__column theme-section__column--no-margin"
        fn-email-placeholder="{{ component.options.placeholder | escape }}"
        fn-button-text="{{ component.options.button | default: button_text }}"
        fn-button-class="button button--style button--main theme-newsletter__submit"
      >
        {{ newsletter_form }}

        {% if component.options.disclaimer != blank %}
          <div class="theme-newsletter__disclaimer check-empty" {{ component.attributes.textfield.disclaimer }}>{{ component.options.disclaimer }}</div>
        {% endif %}
      </newsletter-form>
    </div>
  </div>

  {% if image_desktop != blank %}
    {{ background_image }}
  {% endif %}
</section>
