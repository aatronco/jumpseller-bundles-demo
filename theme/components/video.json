{
  "name": "Video",
  "icon": "video",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-video/).",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__login"
  ],
  "options": {
    "content_type": {
      "name": "Type",
      "type": "select",
      "default": "video",
      "options": [
        {
          "label": "Embed video",
          "value": "video"
        },
        {
          "label": "Video URL",
          "value": "src"
        }
      ]
    },
    "video": {
      "name": "Embed code",
      "type": "video",
      "help": "Copy and paste here the URL or iframe from YouTube or Vimeo.",
      "default": "",
      "visible_if": "{{ block.options.content_type == 'video' }}"
    },
    "src": {
      "name": "Source URL",
      "type": "input",
      "help": "Paste a URL to a video file or a YouTube link.",
      "default": "",
      "visible_if": "{{ block.options.content_type == 'src' }}"
    },
    "ratio": {
      "name": "Ratio",
      "type": "select",
      "help": "Allows to define the dimension for the video.",
      "default": "landscape",
      "options": [
        {
          "label": "Landscape",
          "value": "landscape"
        },
        {
          "label": "Portrait",
          "value": "portrait"
        },
        {
          "label": "Rectangular",
          "value": "rectangular"
        },
        {
          "label": "Square",
          "value": "square"
        }
      ]
    },
    "enable_inner_width": {
      "name": "Adjust Video width",
      "type": "checkbox",
      "default": false
    },
    "inner_width": {
      "name": "Width",
      "type": "select",
      "default": "large",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ],
      "visible_if": "{{ block.options.enable_inner_width }}"
    },
    "content_alignment_x": {
      "name": "Horizontal position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.enable_inner_width }}"
    },
    "controls": {
      "name": "Controls",
      "type": "checkbox",
      "help": "Whether video controls should be displayed.",
      "default": true,
      "visible_if": "{{ block.options.content_type == 'src' and block.options.src != blank }}"
    },
    "autoplay": {
      "name": "Autoplay",
      "type": "checkbox",
      "help": "Whether video should start playing automatically. If enabled, the video will also start muted.",
      "default": true,
      "visible_if": "{{ block.options.content_type == 'src' and block.options.src != blank }}"
    },
    "muted": {
      "name": "Muted",
      "type": "checkbox",
      "help": "Whether video should start with no audio.",
      "default": false,
      "visible_if": "{{ block.options.content_type == 'src' and block.options.src != blank and block.options.autoplay == false }}"
    },
    "loop": {
      "name": "Loop",
      "type": "checkbox",
      "help": "Whether video should loop.",
      "default": true,
      "visible_if": "{{ block.options.content_type == 'src' and block.options.src != blank }}"
    },
    "width": {
      "name": "Width",
      "type": "select",
      "help": "When choosing **Default**, the option defined at [Theme settings > Design > Theme styles > Maximum container width](/general/design) will be applied.",
      "default": "default",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Small",
          "value": "1320px"
        },
        {
          "label": "Medium",
          "value": "1620px"
        },
        {
          "label": "Large",
          "value": "1920px"
        },
        {
          "label": "Extra Large",
          "value": "2220px"
        },
        {
          "label": "Browser width",
          "value": "100vw"
        }
      ]
    },
    "spacing": {
      "name": "Left and right space",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_spacing != 'none' }}"
    },
    "corners": {
      "name": "Rounded corners",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_corners_style != 'rectangular' }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 32,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 32,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Appearance",
      "type": "heading",
      "before": "width"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [],
  "presets": [
    {
      "name": "Video",
      "category": "Content"
    }
  ]
}