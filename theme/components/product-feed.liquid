{% assign section_id = 'theme-section-' | append: component.id %}
{% assign display_option = 'grid' %}
{% assign section_width = component.options.width | replace: 'default', options.theme_width %}

{% capture t_no_products_matched_default %}{% t "No products matched the selected filters" %}.{% endcapture %}
{% assign t_no_products_matched = options.t_no_products_matched | default: t_no_products_matched_default %}

{% capture empty_message %}
  <div class="col-12 text-center theme-message">
    <div class="theme-message__wrapper">
      <h5 class="theme-message__title">{{ t_no_products_matched }}</h5>
      <div class="theme-message__text check-empty">{{ options.t_try_removing_filters }}</div>
    </div>
  </div>
{% endcapture %}

{% capture category_feed %}
  {% paginate category.products by component.options.limit %}
    {% if filters != empty and paged.total == 0 %}
      <div class="row theme-section__content">
        {{ empty_message }}
      </div>
    {% endif %}

    <div class="row theme-section__content">
      {% for prod in paged.products %}
        {% render 'product_block', prod: prod, display_option: display_option, section_width: section_width, block_index: forloop.index %}
      {% endfor %}
    </div>

    {% if paged.total_pages > 1 %}
      <div class="row theme-section__content">
        {{ pager }}
      </div>
    {% endif %}
  {% endpaginate %}
{% endcapture %}

{% capture search_feed %}
  {% paginate search.results by component.options.limit %}
    {% if filters != empty and paged.total == 0 %}
      <div class="row theme-section__content">
        {{ empty_message }}
      </div>
    {% endif %}

    <div class="row theme-section__content">
      {% for prod in paged.results %}
        {% render 'product_block', prod: prod, display_option: display_option, section_width: section_width, block_index: forloop.index %}
      {% endfor %}
    </div>

    {% if paged.total_pages > 1 %}
      <div class="row theme-section__content">
        {{ pager }}
      </div>
    {% endif %}
  {% endpaginate %}
{% endcapture %}

{% capture filters_button %}
  <div class="col-12 text-center d-none theme-section__column">
    <a
      role="button"
      class="button button--style button--secondary button--bordered"
      data-bs-toggle="offcanvas"
      data-bs-target="#sidebar-filters"
      aria-controls="sidebar-filters"
      aria-label="{% t 'Filters' %}"
    >
      <i class="theme-icon ph ph-sliders-horizontal"></i> {% t "Filters" -%}
    </a>
  </div>
{% endcapture %}

<style>
  #{{ section_id }} {
    --theme-max-width: {{ section_width }};
    --section-margin-top: {{ component.options.margin_top }}px;
    --section-margin-bottom: {{ component.options.margin_bottom }}px;
  }
</style>

<section id="{{ section_id }}" class="container-fluid theme-section theme-section--feed" data-bundle-color="{{ component.options.bundle_color }}" {{ component.attributes }}>
  <div class="container container--adjust theme-section__container">
    <div class="row theme-section__content">
      {% case template %}
        {% when 'category' %}
          {% if category.products == empty %}
            {% render 'theme_message' %}
          {% elsif options.filters_desktop %}
            {{- filters_button -}}

            <div class="col-md-4 col-lg-3 col-xl-2 d-none d-md-block theme-section__filters">
              {% if request.preview_mode %}
                {% render 'theme_filters' %}
              {% endif %}
            </div>

            <div class="col-12 col-md-8 col-lg-9 col-xl-10 theme-section__feed">
              {{ category_feed }}
            </div>
          {% else %}
            {{- filters_button -}}
            <div class="col-12 theme-section__feed">
              {{ category_feed }}
            </div>
          {% endif %}
        {% when 'searchresults' %}
          {% if search.results.size == 0 %}
            {% render 'theme_message' %}
          {% elsif search.results.size > 0 and options.filters_desktop %}
            {{- filters_button -}}

            <div class="col-md-4 col-lg-3 col-xl-2 d-none d-md-block theme-section__filters">
              {% if request.preview_mode %}
                {% render 'theme_filters' %}
              {% endif %}
            </div>

            <div class="col-12 col-md-8 col-lg-9 col-xl-10 theme-section__feed">
              {{ search_feed }}
            </div>
          {% else %}
            {{- filters_button -}}
            <div class="col-12 theme-section__feed">
              {{ search_feed }}
            </div>
          {% endif %}
      {% endcase %}
    </div>
  </div>
</section>

{% render 'sidebar_filters' %}
