{
  "name": "Share",
  "icon": "share-nodes",
  "max_usage": 1,
  "required": true,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "page"
  ],
  "options": {
    "title": {
      "name": "Title",
      "type": "input",
      "default": "Share this article"
    },
    "show_facebook": {
      "name": "Facebook",
      "type": "checkbox",
      "default": true
    },
    "show_twitter": {
      "name": "𝕏 (𝕏)",
      "type": "checkbox",
      "default": true
    },
    "show_whatsapp": {
      "name": "WhatsApp",
      "type": "checkbox",
      "default": true
    },
    "show_pinterest": {
      "name": "Pinterest",
      "type": "checkbox",
      "default": true
    },
    "show_email": {
      "name": "Email",
      "type": "checkbox",
      "default": false
    },
    "show_clipboard": {
      "name": "Copy to clipboard",
      "type": "checkbox",
      "default": true
    },
    "text_alignment_desktop": {
      "name": "Alignment (desktop)",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "text_alignment_mobile": {
      "name": "Alignment (mobile)",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 32,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 40,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Sharing options",
      "type": "heading",
      "before": "show_facebook"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "text_alignment_desktop"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [],
  "presets": [
    {
      "name": "Share",
      "category": "Core"
    }
  ]
}