{% assign section_id = 'theme-section-' | append: component.id %}
{% assign section_width = component.options.width | replace: 'default', options.theme_width %}

{% assign data_spacing = component.options.spacing %}
{% if options.theme_spacing == 'none' %}
  {% assign data_spacing = false %}
{% endif %}

{% assign data_corners = component.options.corners %}
{% if options.theme_corners_style == 'rectangular' %}
  {% assign data_corners = false %}
{% endif %}

{% if component.options.enable_inner_width %}
  {% case component.options.inner_width %}
    {% when 'large' %}
      {% assign inner_width = 'col-12 col-md-11 col-lg-10' %}
    {% when 'medium' %}
      {% assign inner_width = 'col-12 col-md-9 col-lg-8' %}
    {% when 'small' %}
      {% assign inner_width = 'col-12 col-md-7 col-lg-6' %}
  {% endcase %}

  {% assign alignment = 'justify-content-' | append: component.options.content_alignment_x %}
{% else %}
  {% assign inner_width = 'col-12' %}
  {% assign alignment = 'justify-content-start' %}
{% endif %}

<style>
  #{{ section_id }} {
    --theme-max-width: {{ section_width }};
    --section-margin-top: {{ component.options.margin_top }}px;
    --section-margin-bottom: {{ component.options.margin_bottom }}px;
  }
</style>
{% case component.options.content_type %}
  {% when 'video' %}
    <div
      id="{{ section_id }}"
      class="container-fluid theme-section theme-video"
      data-spacing="{{ data_spacing }}"
      data-corners="{{ data_corners }}"
      data-bundle-color="{{ component.options.bundle_color }}"
      {% if options.theme_animate %}
        data-aos-once="{% if component.options.animate %}{{ component.options.animate_repeat }}{% else %}{{ options.theme_animate_repeat }}{% endif %}"
        data-aos="{% if component.options.animate %}{{ component.options.animate_type }}{% else %}{{ options.theme_animate_type }}{% endif %}"
        data-aos-delay="{% if component.options.animate %}{{ component.options.animate_delay }}{% else %}{{ options.theme_animate_delay }}{% endif %}"
      {% endif %}
      {{ component.attributes }}
    >
      {% assign video_placeholder = '<div class="theme-image-placeholder theme-image-placeholder--video"></div>' -%}
      <div class="container container--adjust theme-section__container">
        <div class="row {{ alignment }} theme-section__content">
          <div class="{{ inner_width }} theme-section__column theme-section__column--no-margin">
            <div class="theme-section__embed theme-section__embed--no-padding aspect-ratio-{{ component.options.ratio }}">
              {{ component.options.video | default: video_placeholder }}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% when 'src' %}
    <video-player
      id="{{ section_id }}"
      class="container-fluid theme-section video-player"
      data-spacing="{{ data_spacing }}"
      data-corners="{{ data_corners }}"
      data-bundle-color="{{ component.options.bundle_color }}"
      {% if component.options.animate %}
        data-aos-once="{{ component.options.animate_repeat }}" data-aos="{{ component.options.animate_type }}" data-aos-delay="{{ component.options.animate_delay }}"
      {% endif %}
      {{ component.attributes }}
    >
      {% capture video_source %}
        {% if component.options.src != blank %}
          <div class="video-player__wrapper aspect-ratio-{{ component.options.ratio }}"></div>
        {% else %}
          <div class="theme-image-placeholder theme-image-placeholder--video aspect-ratio-{{ component.options.ratio }}"></div>
        {% endif %}
      {% endcapture %}
      <script type="application/json">
        {
          "src": {{ component.options.src | json }},
          "options": {
            "autoplay": {{ component.options.autoplay | json }},
            "controls": {{ component.options.controls | json }},
            "loop": {{ component.options.loop | json }},
            "muted": {{ component.options.muted | json }}
          }
        }
      </script>

      <div class="container container--adjust theme-section__container">
        {% if section_width == 'full' %}
          {{ video_source }}
        {% else %}
          <div class="row {{ alignment }} theme-section__content">
            <div class="{{ inner_width }} theme-section__column theme-section__column--no-margin">
              {{ video_source }}
            </div>
          </div>
        {% endif %}
      </div>
    </video-player>
{% endcase %}
