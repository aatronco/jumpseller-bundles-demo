{% capture t_go_to_default %}{% t "Go to" %}{% endcapture %}
{% assign t_go_to = options.t_go_to | default: t_go_to_default %}

{% case footer-menu-2.options.column_width %}
  {% when 'auto' -%}
    {%- assign column_width = 'col-12 col-md' %}
  {% when 'half' -%}
    {%- assign column_width = 'col-12 col-md-6' %}
  {% when 'full' -%}
    {%- assign column_width = 'col-12' %}
{% endcase %}

<div class="{{ column_width }} footer__column" {{ footer-menu-2.attributes }}>
  <div class="footer__content">
    <h3 class="footer__title check-empty" {{ footer-menu-2.attributes.textfield.title }}>
      {{- footer-menu-2.options.title -}}
    </h3>

    <ul class="no-bullet footer__menu">
      {%- for item in menu.footer_2.items -%}
        <li class="footer__item">
          <a
            href="{{ item.url }}"
            class="footer__link"
            title="{{ t_go_to }} {{ item.name }}"
            {% if item.external %}
              target="_blank"
            {% endif %}
          >
            {{- item.name -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
