{
  "name": "Footer",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/theme-customization/#footer).",
  "max_usage": 1,
  "required": true,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__account",
    "customer__address",
    "customer__details",
    "customer__login",
    "customer__reset_password"
  ],
  "options": {
    "width": {
      "name": "Width",
      "type": "select",
      "help": "When choosing **Default**, the option defined at [Theme settings > Design > Theme styles > Maximum container width](/general/design) will be applied.",
      "default": "default",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Small",
          "value": "1320px"
        },
        {
          "label": "Medium",
          "value": "1620px"
        },
        {
          "label": "Large",
          "value": "1920px"
        },
        {
          "label": "Extra Large",
          "value": "2220px"
        },
        {
          "label": "Browser width",
          "value": "100vw"
        }
      ]
    },
    "store_payments": {
      "name": "Show payment methods",
      "type": "checkbox",
      "help": "Allows to show the badges of the available payment methods added in your store's [checkout configuration](/admin/payment_methods).",
      "default": true
    },
    "store_payments_options": {
      "name": "Show payment options badges",
      "type": "checkbox",
      "help": "Allows to show additional badges for the payment options offered by the payment methods of your store.",
      "default": false,
      "visible_if": "{{ block.options.store_payments }}"
    },
    "partners": {
      "name": "Payment methods list",
      "type": "partners",
      "help": "Allows you to add payment badges manually and individually."
    },
    "scroll": {
      "name": "Show",
      "type": "checkbox",
      "help": "Allows to display a link for users to quickly scroll to the top of the page upon click.",
      "default": false
    },
    "scroll_position": {
      "name": "Position",
      "type": "select",
      "help": "Allows to define the position in which the link will be displayed.",
      "default": "start",
      "options": [
        {
          "label": "Beginning of the Footer",
          "value": "start"
        },
        {
          "label": "End of the Footer",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.scroll }}"
    },
    "scroll_icon": {
      "name": "Icon",
      "type": "ph_icon",
      "help": "Choose an icon to display.",
      "default": "ph ph-arrow-up",
      "visible_if": "{{ block.options.scroll }}"
    },
    "scroll_text": {
      "name": "Text",
      "type": "input",
      "default": "Back to top",
      "visible_if": "{{ block.options.scroll }}"
    },
    "scroll_uppercase": {
      "name": "All caps",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.scroll }}"
    },
    "align_desktop": {
      "name": "Alignment (desktop)",
      "type": "select",
      "default": "text-md-start",
      "options": [
        {
          "label": "Left",
          "value": "text-md-start"
        },
        {
          "label": "Center",
          "value": "text-md-center"
        },
        {
          "label": "Right",
          "value": "text-md-end"
        }
      ]
    },
    "align_mobile": {
      "name": "Alignment (mobile)",
      "type": "select",
      "default": "text-start",
      "options": [
        {
          "label": "Left",
          "value": "text-start"
        },
        {
          "label": "Center",
          "value": "text-center"
        },
        {
          "label": "Right",
          "value": "text-end"
        }
      ]
    },
    "titles_uppercase": {
      "name": "Titles in all caps",
      "type": "checkbox",
      "default": false
    },
    "titles_underline": {
      "name": "Underline titles",
      "type": "checkbox",
      "default": false
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "system-1",
      "pack": "color"
    }
  },
  "presentation": [
    {
      "name": "Payments",
      "type": "heading",
      "before": "store_payments"
    },
    {
      "name": "'Scroll to Top' link",
      "type": "heading",
      "before": "scroll"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "align_desktop"
    }
  ],
  "mode": "children",
  "blocks": [
    {
      "type": "footer-about",
      "multiple": false,
      "property": "footer-about"
    },
    {
      "type": "footer-menu-1",
      "multiple": false,
      "property": "footer-menu-1"
    },
    {
      "type": "footer-menu-2",
      "multiple": false,
      "property": "footer-menu-2"
    },
    {
      "type": "footer-contact-information",
      "multiple": false,
      "property": "footer-contact-information"
    },
    {
      "type": "footer-locations",
      "multiple": false,
      "property": "footer-locations"
    },
    {
      "type": "footer-divider",
      "multiple": true,
      "property": "footer-divider"
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "category": "Core"
    }
  ]
}