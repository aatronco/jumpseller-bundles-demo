{
  "name": "Accordion",
  "icon": "arrows-from-dotted-line",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-accordion/).",
  "max_usage": null,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "checkout__cart",
    "checkout__checkout",
    "customer__account",
    "customer__login"
  ],
  "options": {
    "enable_width": {
      "name": "Adjust Accordion width",
      "type": "checkbox",
      "default": false
    },
    "width": {
      "name": "Width",
      "type": "select",
      "default": "large",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ],
      "visible_if": "{{ block.options.enable_width }}"
    },
    "content_alignment_x": {
      "name": "Horizontal position",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.enable_width }}"
    },
    "collapse": {
      "name": "Enable collapsible items",
      "type": "checkbox",
      "default": true
    },
    "first": {
      "name": "First item opened",
      "type": "checkbox",
      "default": false
    },
    "show_icons": {
      "name": "Show icons",
      "type": "checkbox",
      "default": false
    },
    "heading": {
      "name": "Enable heading",
      "type": "checkbox",
      "default": true
    },
    "heading_subtitle": {
      "name": "Subtitle",
      "type": "input",
      "default": "",
      "placeholder": "Add a subtitle to your section",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_title": {
      "name": "Title",
      "type": "input",
      "default": "Section title",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_description": {
      "name": "Description",
      "type": "input",
      "default": "You can add a text or description to provide more context on what this section is about.",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link": {
      "name": "Link",
      "type": "link",
      "default": null,
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link_text": {
      "name": "Link text",
      "type": "input",
      "default": "Read more",
      "visible_if": "{{ block.options.heading and block.options.heading_link != blank }}"
    },
    "borders": {
      "name": "Borders style",
      "type": "select",
      "default": "all",
      "options": [
        {
          "label": "All sides",
          "value": "all"
        },
        {
          "label": "Top & Bottom",
          "value": "top-bottom"
        },
        {
          "label": "No borders",
          "value": "none"
        }
      ]
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Heading options",
      "type": "heading",
      "before": "heading"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "borders"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [
    {
      "type": "accordion-item",
      "multiple": true,
      "property": "items"
    }
  ],
  "presets": [
    {
      "name": "Accordion",
      "category": "Information",
      "children": [
        {
          "type": "accordion-item",
          "options": {
            "title": "Example accordion item title",
            "content": "Here goes the text, description or content for each one of the accordion items that you add."
          }
        },
        {
          "type": "accordion-item",
          "options": {
            "title": "Example accordion item title",
            "content": "Here goes the text, description or content for each one of the accordion items that you add."
          }
        },
        {
          "type": "accordion-item",
          "options": {
            "title": "Example accordion item title",
            "content": "Here goes the text, description or content for each one of the accordion items that you add."
          }
        }
      ]
    }
  ]
}