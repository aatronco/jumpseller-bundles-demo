{
  "name": "Instagram",
  "icon": "camera-polaroid",
  "help": "To display Instagram posts, you first need to [connect your account](/admin/settings/general/store_info). For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-instagram/).",
  "max_usage": 1,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error"
  ],
  "options": {
    "limit": {
      "name": "Amount of posts",
      "type": "select",
      "default": "6",
      "options": [
        {
          "label": "6",
          "value": "6"
        },
        {
          "label": "8",
          "value": "8"
        },
        {
          "label": "12",
          "value": "12"
        }
      ]
    },
    "title": {
      "name": "Title",
      "type": "input",
      "default": "Follow us on Instagram"
    },
    "spacing": {
      "name": "Space between",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_spacing != 'none' }}"
    },
    "display": {
      "name": "Display",
      "type": "select",
      "default": "grid",
      "options": [
        {
          "label": "Carousel",
          "value": "carousel"
        },
        {
          "label": "Grid",
          "value": "grid"
        }
      ]
    },
    "autoplay": {
      "name": "Autoplay",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.display == 'carousel' }}"
    },
    "autoplay_speed": {
      "name": "Autoplay speed",
      "type": "slider",
      "default": 4000,
      "min": 1000,
      "max": 10000,
      "step": 1000,
      "unit": "ms",
      "visible_if": "{{ block.options.display == 'carousel' and block.options.autoplay }}"
    },
    "autoplay_continuous": {
      "name": "Continuous autoplay",
      "type": "checkbox",
      "help": "If enabled, the autoplay transition will work with a continuous loop without stopping. Also, the carousel navigation elements will be hidden.",
      "default": false,
      "visible_if": "{{ block.options.display == 'carousel' and block.options.autoplay }}"
    },
    "autoplay_speed_mobile": {
      "name": "Autoplay speed (mobile)",
      "type": "slider",
      "default": 2000,
      "min": 1000,
      "max": 5000,
      "step": 1000,
      "unit": "ms",
      "visible_if": "{{ block.options.display == 'carousel' and block.options.autoplay and block.options.autoplay_continuous }}"
    },
    "show_arrows": {
      "name": "Arrows",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.display == 'carousel' }}"
    },
    "show_arrows_hover": {
      "name": "Arrows on hover",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.display == 'carousel' and block.options.show_arrows }}"
    },
    "show_dots": {
      "name": "Dots",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.display == 'carousel' }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Carousel settings",
      "type": "heading",
      "before": "autoplay"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "margin_top"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [],
  "presets": [
    {
      "name": "Instagram",
      "category": "Social"
    }
  ]
}