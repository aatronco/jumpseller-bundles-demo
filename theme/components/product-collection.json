{
  "name": "Product collection",
  "icon": "tag",
  "max_usage": 11,
  "required": false,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "home",
    "product",
    "category",
    "page",
    "page_category",
    "searchresults",
    "contactpage",
    "error",
    "customer__login"
  ],
  "options": {
    "source": {
      "name": "Collection",
      "type": "select",
      "default": "featured",
      "options": [
        {
          "label": "Featured",
          "value": "featured"
        },
        {
          "label": "Latest",
          "value": "latest"
        },
        {
          "label": "Category",
          "value": "category"
        },
        {
          "label": "Handpicked",
          "value": "handpicked"
        },
        {
          "label": "Recently viewed",
          "value": "recently"
        },
        {
          "label": "Best sold",
          "value": "best_sold"
        }
      ]
    },
    "category": {
      "name": "Category",
      "type": "category",
      "visible_if": "{{ block.options.source == 'category' }}"
    },
    "handpicked": {
      "name": "Products",
      "type": "product_list",
      "visible_if": "{{ block.options.source == 'handpicked' }}"
    },
    "limit": {
      "name": "Items to display",
      "type": "slider",
      "default": 10,
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "",
      "visible_if": "{{ block.options.source != 'handpicked' }}"
    },
    "width": {
      "name": "Width",
      "type": "select",
      "help": "When choosing **Default**, the option defined at [Theme settings > Design > Theme styles > Maximum container width](/general/design) will be applied.",
      "default": "default",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Small",
          "value": "1320px"
        },
        {
          "label": "Medium",
          "value": "1620px"
        },
        {
          "label": "Large",
          "value": "1920px"
        },
        {
          "label": "Extra Large",
          "value": "2220px"
        },
        {
          "label": "Browser width",
          "value": "100vw"
        }
      ]
    },
    "display": {
      "name": "Display",
      "type": "select",
      "default": "grid",
      "options": [
        {
          "label": "Carousel",
          "value": "carousel"
        },
        {
          "label": "Grid",
          "value": "grid"
        }
      ]
    },
    "autoplay": {
      "name": "Autoplay",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.display == 'carousel' }}"
    },
    "autoplay_speed": {
      "name": "Autoplay speed",
      "type": "slider",
      "default": 4000,
      "min": 1000,
      "max": 6000,
      "step": 500,
      "unit": "ms",
      "visible_if": "{{ block.options.display == 'carousel' and block.options.autoplay }}"
    },
    "autoplay_continuous": {
      "name": "Continuous autoplay",
      "type": "checkbox",
      "help": "If enabled, the autoplay transition will work with a continuous loop without stopping. Also, the carousel navigation elements will be hidden.",
      "default": false,
      "visible_if": "{{ block.options.display == 'carousel' and block.options.autoplay }}"
    },
    "autoplay_speed_mobile": {
      "name": "Autoplay speed (mobile)",
      "type": "slider",
      "default": 2000,
      "min": 1000,
      "max": 5000,
      "step": 1000,
      "unit": "ms",
      "visible_if": "{{ block.options.display == 'carousel' and block.options.autoplay and block.options.autoplay_continuous }}"
    },
    "show_arrows": {
      "name": "Arrows",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.display == 'carousel' }}"
    },
    "show_arrows_hover": {
      "name": "Arrows on hover",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.display == 'carousel' and block.options.show_arrows }}"
    },
    "show_dots": {
      "name": "Dots",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.display == 'carousel' }}"
    },
    "heading": {
      "name": "Enable heading",
      "type": "checkbox",
      "default": true
    },
    "heading_subtitle": {
      "name": "Subtitle",
      "type": "input",
      "default": "",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_title": {
      "name": "Title",
      "type": "input",
      "help": "Allows to replace the name of the selected category.",
      "default": "",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_description": {
      "name": "Description",
      "type": "text",
      "default": "",
      "placeholder": "Add a description to provide more information about the selected category",
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link": {
      "name": "Link",
      "type": "link",
      "default": null,
      "visible_if": "{{ block.options.heading }}"
    },
    "heading_link_text": {
      "name": "Link text",
      "type": "input",
      "default": "See more products",
      "visible_if": "{{ block.options.source == 'category' and block.options.heading and block.options.category != blank and block.options.heading_link }}"
    },
    "display_image": {
      "name": "Show image",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.source != 'recently' }}"
    },
    "image_desktop": {
      "name": "Image",
      "type": "image",
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image }}"
    },
    "image_mobile": {
      "name": "Image (mobile)",
      "type": "image",
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.image_desktop.url != blank }}"
    },
    "show_image_content": {
      "name": "Image content",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image }}"
    },
    "image_overlay": {
      "name": "Overlay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "",
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content }}"
    },
    "image_title": {
      "name": "Title",
      "type": "input",
      "default": "",
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content }}"
    },
    "image_button": {
      "name": "Button text",
      "type": "input",
      "default": "See more products",
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content and block.options.heading_link != blank }}"
    },
    "image_content_align_desktop": {
      "name": "Alignment (desktop)",
      "type": "select",
      "default": "text-md-center",
      "options": [
        {
          "label": "Left",
          "value": "text-md-start"
        },
        {
          "label": "Center",
          "value": "text-md-center"
        },
        {
          "label": "Right",
          "value": "text-md-end"
        }
      ],
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content }}"
    },
    "image_content_align_mobile": {
      "name": "Alignment (mobile)",
      "type": "select",
      "default": "text-center",
      "options": [
        {
          "label": "Left",
          "value": "text-start"
        },
        {
          "label": "Center",
          "value": "text-center"
        },
        {
          "label": "Right",
          "value": "text-end"
        }
      ],
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content }}"
    },
    "content_alignment_y_image_desktop": {
      "name": "Vertical position (desktop)",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content }}"
    },
    "content_alignment_y_image_mobile": {
      "name": "Vertical position (mobile)",
      "type": "select",
      "default": "center",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content }}"
    },
    "image_bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "default": "system-1",
      "pack": "color",
      "visible_if": "{{ block.options.source != 'recently' and block.options.display_image and block.options.show_image_content }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Carousel settings",
      "type": "heading",
      "before": "autoplay"
    },
    {
      "name": "Heading options",
      "type": "heading",
      "before": "heading"
    },
    {
      "help": "If `Collection` is **Category**, its image will be displayed by default, which you can override by uploading images for desktop and mobile devices. For any other `Collection` option, you will need to upload them here so they are displayed.",
      "name": "Featured image",
      "type": "heading",
      "before": "display_image"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "margin_top"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "subcomponents",
  "blocks": [],
  "presets": [
    {
      "name": "Featured category",
      "options": {
        "source": "category"
      },
      "category": "Products"
    },
    {
      "name": "Featured products",
      "category": "Products"
    },
    {
      "name": "Handpicked products",
      "options": {
        "source": "handpicked"
      },
      "category": "Products"
    },
    {
      "name": "Latest products",
      "options": {
        "source": "latest"
      },
      "category": "Products"
    },
    {
      "name": "Recently viewed products",
      "options": {
        "source": "recently"
      },
      "category": "Customers"
    },
    {
      "name": "Best sold products",
      "options": {
        "source": "best_sold"
      },
      "category": "Products"
    }
  ]
}