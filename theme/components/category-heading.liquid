{% assign section_id = 'theme-section-' | append: component.id %}

{% assign filters_desktop = options.filters_desktop %}

{% assign align_desktop = options.text_alignment_heading_desktop %}
{% assign align_mobile = options.text_alignment_heading_mobile %}

{% case align_desktop %}
  {% when 'center' %}
    {% if filters_desktop %}
      {% assign column_class_title = 'order-1 col-12 col-md-8 offset-md-2' %}
      {% assign column_class_underline = 'col-12 order-2' %}
      {% assign column_class_description = 'col-12 order-3' %}
      {% assign column_class_filter = 'order-4 col-12 d-block d-md-none text-md-end text-' | append: align_mobile %}
    {% else %}
      {% assign column_class_title = 'col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3' %}
      {% assign column_class_underline = 'col-12 order-2 order-md-3' %}
      {% assign column_class_description = 'col-12 order-3 order-md-4' %}
      {% assign column_class_filter = 'order-4 order-md-2 col-12 col-md-2 col-lg-3 text-md-end text-' | append: align_mobile %}
    {% endif %}
  {% when 'start' %}
    {% if filters_desktop %}
      {% assign column_class_title = 'order-1 col-12' %}
      {% assign column_class_underline = 'col-12 order-2' %}
      {% assign column_class_description = 'col-12 order-3' %}
      {% assign column_class_filter = 'order-4 col-12 d-block d-md-none text-md-end text-' | append: align_mobile %}
    {% else %}
      {% assign column_class_title = 'col-12 col-md-8 col-lg-9' %}
      {% assign column_class_underline = 'col-12 order-2 order-md-3' %}
      {% assign column_class_description = 'col-12 order-3 order-md-4' %}
      {% assign column_class_filter = 'order-4 order-md-2 col-12 col-md-4 col-lg-3 text-md-end text-' | append: align_mobile %}
    {% endif %}
{% endcase %}

{%- capture section_title -%}
  {% case template %}
    {% when 'category' %}
      {{- category.name -}}
    {% when 'page_category' %}
      {{- page_category.name -}}
    {% when 'searchresults' %}
      {%- t "Search results" -%}
  {% endcase %}
{%- endcapture -%}

{%- capture section_description -%}
  <div class="{{ column_class_description }} theme-section__column{% if template == 'searchresults' and filters_desktop %} d-md-none{% endif %}">
    <div class="theme-section__description check-empty">
      {%- if template == 'category' and category.description != blank -%}
        {{- category.description | newline_to_br -}}
      {%- elsif template == 'page_category' -%}
        {{- page_category.description | newline_to_br -}}
      {%- elsif template == 'searchresults' -%}
        {%- t "You've searched for: <strong>%{search_query}</strong>", search_query: search.query -%}
      {%- endif -%}
    </div>
  </div>
{%- endcapture -%}

{% case template %}
  {% when 'category' %}
    {%- assign section_image_src = category.images.first -%}
  {% when 'page_category' %}
    {%- assign section_image_src = page_category.images.first -%}
{% endcase %}

{% capture filters_button %}
  {% if category.template != 'Brands' and category.template != 'Show subcategories' and category.template != 'All categories' %}
    <div class="{{ column_class_filter }} order-2 theme-section__column" data-column="filters">
      <a
        role="button"
        class="button button--style button--secondary"
        data-bs-toggle="offcanvas"
        data-bs-target="#sidebar-filters"
        aria-controls="sidebar-filters"
        aria-label="{% t 'Filters' %}"
      >
        <i class="theme-icon ph ph-sliders-horizontal"></i> <span>{% t "Filters" -%}</span>
      </a>
    </div>
  {% endif %}
{% endcapture %}

<style>
  #{{ section_id }} {
    --theme-max-width: {{ options.theme_width }};
    --section-margin-top: {{ component.options.margin_top }}px;
    --section-margin-bottom: {{ component.options.margin_bottom }}px;
    --theme-overlay-opacity: {{ component.options.background_image_overlay | divided_by: 100.00 }};
  }
</style>

<section
  id="{{ section_id }}"
  class="container-fluid theme-section theme-section--heading"
  data-bundle-color="{{ component.options.bundle_color }}"
  {% if options.theme_animate %}
    data-aos-once="{% if component.options.animate %}{{ component.options.animate_repeat }}{% else %}{{ options.theme_animate_repeat }}{% endif %}"
    data-aos="{% if component.options.animate %}{{ component.options.animate_type }}{% else %}{{ options.theme_animate_type }}{% endif %}"
    data-aos-delay="{% if component.options.animate %}{{ component.options.animate_delay }}{% else %}{{ options.theme_animate_delay }}{% endif %}"
  {% endif %}
  {{ component.attributes }}
>
  <div class="container container--adjust theme-section__container">
    <div class="row align-items-start align-items-md-center text-{{ align_mobile }} text-md-{{ align_desktop }} theme-section__heading">
      <div class="{{ column_class_title }} order-1 theme-section__column">
        <h1 class="theme-section__title check-empty">
          {{- section_title -}}
        </h1>
      </div>

      {% render 'component_heading_underline', underline_class: column_class_underline %}

      {% if component.options.description %}
        {{- section_description -}}
      {% endif %}

      {% if template == 'category' and category.products != empty %}
        {{ filters_button }}
      {% elsif template == 'searchresults' and search.results.size > 0 %}
        {{ filters_button }}
      {% endif %}
    </div>
  </div>

  {% if component.options.background_image and section_image_src != blank %}
    <div class="theme-section__media">
      <div class="theme-section__overlay"></div>
      <img src="{{ section_image_src }}" alt="{{ section_title | escape }}" class="theme-section__image" width="auto" height="auto" loading="lazy" decoding="auto" fetchpriority="auto">
    </div>
  {% endif %}
</section>
