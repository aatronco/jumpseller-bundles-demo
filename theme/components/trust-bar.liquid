{% assign section_id = 'theme-section-' | append: component.id %}
{% assign display_option = component.options.display %}
{% assign align_desktop = component.options.content_alignment_x_desktop %}
{% assign align_mobile = component.options.content_alignment_x_mobile %}
{% assign has_icons = component.options.enable_icons %}

{% assign columns_desktop = component.options.columns_desktop %}
{% assign columns_mobile = component.options.columns_mobile %}

{% capture sw_content %}
  {% for trust-block in component.subcomponents['trust-blocks'] %}
    {% render 'components/trust-block', trust-block: trust-block, display_option: display_option, columns_mobile: columns_mobile, columns_desktop: columns_desktop, align_mobile: align_mobile, align_desktop: align_desktop, has_icons: has_icons, block_index: forloop.index %}
  {% endfor %}
{% endcapture %}

{% assign heading_subtitle = component.options.heading_subtitle %}
{% assign heading_title = component.options.heading_title %}
{% assign heading_description = component.options.heading_description %}
{% assign heading_link = component.options.heading_link %}
{% assign heading_link_text = component.options.heading_link_text %}

{% assign show_arrows = component.options.show_arrows %}
{% assign show_arrows_hover = component.options.show_arrows_hover %}
{% assign show_dots = component.options.show_dots %}

<style>
  #{{ section_id }} {
    --theme-max-width: {{ options.theme_width }};
  	--section-margin-top: {{ component.options.margin_top }}px;
  	--section-margin-bottom: {{ component.options.margin_bottom }}px;
   {% if component.options.card %}
     --color-border-opacity: {{ component.options.card_border_opacity | divided_by: 100.00 }};
   {% endif %}
  }
</style>

<section id="{{ section_id }}" class="container-fluid theme-section" data-bundle-color="{{ component.options.bundle_color }}" {{ component.attributes }}>
  <div class="container container--adjust theme-section__container">
    {% render 'component_heading', subtitle: heading_subtitle, title: heading_title, description: heading_description, link: heading_link, link_text: heading_link_text %}

    <div class="row theme-section__content">
      {% if display_option == 'carousel' %}
        <swiper-slider
          class="swiper theme-slider__carousel"
          sw-layout="trust-bar"
          sw-columns-desktop="{{ columns_desktop }}"
          sw-columns-mobile="{{ columns_mobile }}"
          sw-autoplay="{{ component.options.autoplay }}"
          sw-speed="{{ component.options.autoplay_speed }}"
          {% if component.options.autoplay_continuous %}
            sw-continuous="{{ component.options.autoplay_continuous }}"
            sw-speed-mobile="{{ component.options.autoplay_speed_mobile }}"
          {% endif %}
        >
          <div class="swiper-wrapper">
            {{ sw_content }}
          </div>
        </swiper-slider>

        {% unless component.options.autoplay_continuous %}
          {% if show_arrows or show_dots %}
            <div
              class="d-flex align-items-center justify-content-between theme-navigation"
              {% if show_arrows and show_arrows_hover %}
                data-arrows-hover="true"
              {% endif %}
            >
              {% if show_arrows %}
                <button type="button" class="button swiper-button-prev theme-navigation__arrow theme-navigation__arrow--prev" aria-label="{% t 'Previous' %}">
                  <i class="ph ph-caret-left"></i>
                </button>
              {% endif %}

              {% if show_dots %}
                <div class="swiper-pagination d-flex flex-wrap align-items-center justify-content-center theme-navigation__pagination" data-dots-type="{{ options.theme_dots_type }}"></div>
              {% endif %}

              {% if show_arrows %}
                <button type="button" class="button swiper-button-next theme-navigation__arrow theme-navigation__arrow--next" aria-label="{% t 'Next' %}">
                  <i class="ph ph-caret-right"></i>
                </button>
              {% endif %}
            </div>
          {% endif %}
        {% endunless %}
      {% else %}
        {{ sw_content }}
      {% endif %}
    </div>
  </div>
</section>
