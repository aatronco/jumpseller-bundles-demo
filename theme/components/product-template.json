{
  "name": "Template",
  "icon": "archive",
  "help": "For more information about this component and how it works, please visit [this article](/admin/landing?url=/support/component-product-template/).",
  "max_usage": 1,
  "required": true,
  "tag": "div",
  "classes": "",
  "templates_in": [
    "product"
  ],
  "options": {
    "columns_order": {
      "name": "Invert columns order on Desktop",
      "type": "checkbox",
      "default": false
    },
    "text_alignment": {
      "name": "Content alignment",
      "type": "select",
      "default": "start",
      "options": [
        {
          "label": "Left",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "end"
        }
      ]
    },
    "content_gap": {
      "name": "Columns desktop gap",
      "type": "select",
      "help": "Allows to define the amount of space between the **Gallery** and **Content** columns.",
      "default": "large",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ]
    },
    "gallery_type": {
      "name": "Type",
      "type": "select",
      "help": "This will only affect tablets and desktop devices.",
      "default": "carousel",
      "options": [
        {
          "label": "Carousel",
          "value": "carousel"
        },
        {
          "label": "Grid",
          "value": "grid"
        }
      ]
    },
    "gallery_columns": {
      "name": "Columns",
      "type": "select",
      "default": "2",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        }
      ],
      "visible_if": "{{ block.options.gallery_type == 'grid' }}"
    },
    "gallery_image_corners": {
      "name": "Rounded corners",
      "type": "select",
      "default": "all",
      "options": [
        {
          "label": "All",
          "value": "all"
        },
        {
          "label": "Inner",
          "value": "inner"
        },
        {
          "label": "None",
          "value": "none"
        }
      ],
      "visible_if": "{{ options.theme_spacing == 'none' and options.theme_corners_style != 'rectangular' }}"
    },
    "gallery_image_format": {
      "name": "Format Images",
      "type": "checkbox",
      "default": true
    },
    "gallery_image_dimension": {
      "name": "Dimension",
      "type": "select",
      "default": "square",
      "options": [
        {
          "label": "Landscape",
          "value": "landscape"
        },
        {
          "label": "Portrait",
          "value": "portrait"
        },
        {
          "label": "Rectangular",
          "value": "rectangular"
        },
        {
          "label": "Square",
          "value": "square"
        }
      ],
      "visible_if": "{{ block.options.gallery_image_format }}"
    },
    "gallery_image_display": {
      "name": "Display",
      "type": "select",
      "default": "cover",
      "options": [
        {
          "label": "Resize",
          "value": "contain"
        },
        {
          "label": "Crop",
          "value": "cover"
        }
      ],
      "visible_if": "{{ block.options.gallery_image_format }}"
    },
    "gallery_image_sticky": {
      "name": "Sticky gallery",
      "type": "checkbox",
      "default": false,
      "visible_if": "{{ block.options.gallery_type == 'carousel' }}"
    },
    "gallery_thumbs": {
      "name": "Show",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ block.options.gallery_type == 'carousel' }}"
    },
    "gallery_thumbs_position": {
      "name": "Desktop position",
      "type": "select",
      "default": "bottom",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "visible_if": "{{ block.options.gallery_type == 'carousel' and block.options.gallery_thumbs }}"
    },
    "gallery_zoom": {
      "name": "Enable",
      "type": "checkbox",
      "default": true
    },
    "gallery_zoom_size": {
      "name": "Amount",
      "type": "select",
      "help": "Allows to define the amount in which images are gonna be zoomed.",
      "default": "1.5",
      "options": [
        {
          "label": "Small",
          "value": "1.5"
        },
        {
          "label": "Medium",
          "value": "2"
        },
        {
          "label": "Large",
          "value": "3"
        }
      ],
      "visible_if": "{{ block.options.gallery_zoom }}"
    },
    "margin_top": {
      "name": "Top margin",
      "type": "slider",
      "default": 40,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "margin_bottom": {
      "name": "Bottom margin",
      "type": "slider",
      "default": 32,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    "bundle_color": {
      "name": "Content colors",
      "type": "bundle",
      "help": "Choose one of your Palettes shared between your chosen components or create an independent new one.",
      "default": "default",
      "pack": "color"
    },
    "animate": {
      "name": "Customize options",
      "type": "checkbox",
      "help": "Allows to override the animation options defined at [Theme settings > Design > Animations](/general/design) for this specific component.",
      "default": false,
      "visible_if": "{{ options.theme_animate }}"
    },
    "animate_type": {
      "name": "Type",
      "type": "select",
      "default": "fade-up",
      "options": [
        {
          "label": "From down",
          "value": "fade-up"
        },
        {
          "label": "From up",
          "value": "fade-down"
        },
        {
          "label": "From left",
          "value": "fade-right"
        },
        {
          "label": "From right",
          "value": "fade-left"
        },
        {
          "label": "Zoom in",
          "value": "zoom-in"
        },
        {
          "label": "Zoom out",
          "value": "zoom-out"
        }
      ],
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_repeat": {
      "name": "Animate once",
      "type": "checkbox",
      "default": true,
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    },
    "animate_delay": {
      "name": "Delay",
      "type": "slider",
      "default": 50,
      "min": 0,
      "max": 300,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ options.theme_animate and block.options.animate }}"
    }
  },
  "presentation": [
    {
      "name": "Image gallery",
      "type": "heading",
      "before": "gallery_type"
    },
    {
      "name": "Gallery thumbnails",
      "type": "heading",
      "before": "gallery_thumbs"
    },
    {
      "name": "Images zoom",
      "type": "heading",
      "before": "gallery_zoom"
    },
    {
      "name": "Appearance",
      "type": "heading",
      "before": "margin_top"
    },
    {
      "name": "Animations",
      "type": "heading",
      "before": "animate"
    }
  ],
  "mode": "children",
  "blocks": [
    {
      "type": "product-attributes",
      "multiple": false,
      "property": "attributes"
    },
    {
      "type": "product-title",
      "multiple": false,
      "property": "title"
    },
    {
      "type": "product-price",
      "multiple": false,
      "property": "price"
    },
    {
      "type": "product-reviews-stars",
      "multiple": false,
      "property": "reviews-stars"
    },
    {
      "type": "product-stock",
      "multiple": false,
      "property": "stock"
    },
    {
      "type": "product-form",
      "multiple": false,
      "property": "form"
    },
    {
      "type": "product-notification",
      "multiple": false,
      "property": "notification"
    },
    {
      "type": "product-volume-prices",
      "multiple": false,
      "property": "volume-prices"
    },
    {
      "type": "product-stock-locations",
      "multiple": false,
      "property": "stock-locations"
    },
    {
      "type": "product-wishlist",
      "multiple": false,
      "property": "wishlist"
    },
    {
      "type": "product-description",
      "multiple": false,
      "property": "description"
    },
    {
      "type": "product-accordion",
      "multiple": false,
      "property": "accordion"
    },
    {
      "type": "product-fields",
      "multiple": false,
      "property": "fields"
    },
    {
      "type": "product-attachments",
      "multiple": false,
      "property": "attachments"
    },
    {
      "type": "product-line-divider",
      "multiple": true,
      "property": "line-divider"
    },
    {
      "type": "product-share",
      "multiple": false,
      "property": "share"
    },
    {
      "type": "product-custom-code",
      "multiple": true,
      "property": "product-custom-code"
    }
  ],
  "presets": [
    {
      "name": "Product template",
      "category": "Core"
    }
  ]
}