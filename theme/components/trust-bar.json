          "type": "trust-block",
          "options": {
            "icon": "ph ph-credit-card",
            "text": "Pay through certified and encrypted gateways with credit card and bank transfer.",
            "title": "Safe and secure payments"
          }
        },
        {
          "type": "trust-block",
          "options": {
            "icon": "ph ph-headset",
            "text": "We have a specialized team that will assist you with any doubt or help you might need.",
            "title": "Have Questions?",
            "link_text": "Contact us"
          }
        },
        {
          "type": "trust-block",
          "options": {
            "icon": "ph ph-seal-check",
            "text": "All of our products have been tested and certified with high quality standards.",
            "title": "Guaranteed quality products"
          }
        }
      ]
    },
    {
      "name": "Trust bar: Sustainability",
      "options": {
        "heading": true,
        "heading_title": "Our commitment to a better future",
