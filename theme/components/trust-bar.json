            "title": "Eco-Friendly Packaging"
          }
        },
        {
          "type": "trust-block",
          "options": {
            "icon": "ph ph-clock-countdown",
            "text": "We choose quality over quantity.",
            "title": "Made to Last"
          }
        },
        {
          "type": "trust-block",
          "options": {
            "icon": "ph ph-hand-heart",
