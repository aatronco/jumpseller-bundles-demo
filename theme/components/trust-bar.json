            "title": "Privacy Policy"
          }
        },
        {
          "type": "trust-block",
          "options": {
            "icon": "ph ph-envelope",
            "text": "Have questions? We are here to help.",
            "title": "Contact Us",
            "link_text": "Get in touch"
          }
        }
      ]
    }
  ]
}