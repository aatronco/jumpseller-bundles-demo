{
  "name": "Price",
  "icon": "dollar-sign",
  "max_usage": 1,
  "required": true,
  "tag": "div",
  "classes": "",
  "templates_in": [],
  "options": {
    "mobile_first": {
      "name": "Show before product gallery on Mobile",
      "type": "checkbox",
      "default": false
    },
    "display": {
      "name": "Display",
      "type": "select",
      "default": "horizontal",
      "options": [
        {
          "label": "Horizontal",
          "value": "horizontal"
        },
        {
          "label": "Stacked",
          "value": "stack"
        }
      ]
    },
    "show_discount_badge": {
      "name": "Discount label",
      "type": "select",
      "default": "both",
      "options": [
        {
          "label": "Hide",
          "value": "none"
        },
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "Percentage",
          "value": "percentage"
        },
        {
          "label": "Text",
          "value": "text"
        }
      ]
    },
    "discount_badge_shape": {
      "name": "Label shape",
      "type": "select",
      "default": "rectangular",
      "options": [
        {
          "label": "Circular",
          "value": "circular"
        },
        {
          "label": "Rectangular",
          "value": "rectangular"
        },
        {
          "label": "Rounded",
          "value": "rounded"
        }
      ],
      "visible_if": "{{ block.options.show_discount_badge != 'none' }}"
    },
    "show_discount_message": {
      "name": "Show promotions date limit message",
      "type": "checkbox",
      "default": true
    }
  },
  "mode": "subcomponents",
  "blocks": []
}